---
import Post from '../../layouts/Post.astro';
import GrandLayout from '../../layouts/GrandLayout.astro';
import { getCollection, render } from 'astro:content';
import BlochLab from '../../components/BlochLab.astro';
import PhaseLever from '../../components/PhaseLever.astro';
import InterferenceLab from '../../components/InterferenceLab.astro';
import Amplify from '../../components/Amplify.astro';

export async function getStaticPaths() {
  // Only generate routes for published posts. Set `draft: false` in a post's
  // frontmatter to release it. Drafts are still routable on the local dev
  // server (import.meta.env.DEV) so they can be previewed before release.
  const posts = (await getCollection('blog')).filter(p => import.meta.env.DEV || !p.data.draft);
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const d = post.data;
const { Content } = await render(post);

// `grand: true` posts (the wide "go big" layout) get their interactives via the
// MDX components prop; standard posts use Post and import any toys directly.
const grand = !!d.grand;
---

{grand ? (
  <GrandLayout title={d.title} description={d.description} date={d.date} tags={d.tags} image={d.image} project={d.project} math={d.math}>
    <Content components={{ BlochLab, PhaseLever, InterferenceLab, Amplify }} />
  </GrandLayout>
) : (
  <Post title={d.title} description={d.description} date={d.date} tags={d.tags} image={d.image} project={d.project} math={d.math}>
    <Content />
  </Post>
)}
