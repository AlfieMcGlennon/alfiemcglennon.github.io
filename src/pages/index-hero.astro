---
// index-hero.astro — the REAL homepage, kept (photo, about, jump cards), but
// with a much more immersive, "expandable" weather hero: full-viewport live
// Reading sky, a sun/moon that tracks day vs night, stars at night, a layered
// horizon silhouette, parallax depth on mouse + scroll, and a scroll cue. On
// brand (warm/light), reduced-motion-safe. Concept route — the live homepage at
// index.astro is untouched. No copula pin; the photo stays.
import Base from '../layouts/Base.astro';
---

<Base>
  <section class="hero" data-hero aria-label="Introduction">
    <div class="sky" data-parallax aria-hidden="true">
      <div class="stars" aria-hidden="true"></div>
      <div class="celestial sun" data-sun aria-hidden="true"></div>
      <div class="celestial moon" data-moon aria-hidden="true"></div>
      <svg class="sky-svg" viewBox="0 0 1200 600" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="sky-gradient" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" class="sky-stop-top" /><stop offset="55%" class="sky-stop-mid" /><stop offset="100%" class="sky-stop-bot" />
          </linearGradient>
          <filter id="cloud-blur" x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation="6" /></filter>
          <symbol id="cloud-a" viewBox="0 0 320 100"><ellipse cx="80" cy="60" rx="80" ry="26" fill="#fff" /><ellipse cx="160" cy="48" rx="100" ry="32" fill="#fff" /><ellipse cx="240" cy="62" rx="74" ry="22" fill="#fff" /></symbol>
          <symbol id="cloud-b" viewBox="0 0 260 90"><ellipse cx="70" cy="55" rx="70" ry="22" fill="#fff" /><ellipse cx="150" cy="44" rx="80" ry="28" fill="#fff" /><ellipse cx="210" cy="58" rx="50" ry="18" fill="#fff" /></symbol>
          <symbol id="cloud-c" viewBox="0 0 200 70"><ellipse cx="60" cy="40" rx="56" ry="18" fill="#fff" /><ellipse cx="130" cy="34" rx="62" ry="22" fill="#fff" /></symbol>
          <pattern id="rain-pattern" x="0" y="0" width="60" height="100" patternUnits="userSpaceOnUse" patternTransform="rotate(14)">
            <line x1="10" y1="0" x2="10" y2="22" stroke="#7a8896" stroke-width="1.1" stroke-linecap="round" opacity="0.7" />
            <line x1="34" y1="40" x2="34" y2="64" stroke="#7a8896" stroke-width="1.1" stroke-linecap="round" opacity="0.55" />
            <line x1="50" y1="70" x2="50" y2="90" stroke="#7a8896" stroke-width="1.1" stroke-linecap="round" opacity="0.6" />
          </pattern>
        </defs>
        <rect width="1200" height="600" fill="url(#sky-gradient)" />
        <g class="cloud-layer cloud-layer-slow" data-depth="6" filter="url(#cloud-blur)">
          <use href="#cloud-a" x="-400" y="70" width="320" height="100" opacity="0.5" /><use href="#cloud-c" x="220" y="120" width="200" height="70" opacity="0.4" /><use href="#cloud-b" x="720" y="55" width="260" height="90" opacity="0.5" /><use href="#cloud-a" x="1120" y="100" width="320" height="100" opacity="0.45" />
        </g>
        <g class="cloud-layer cloud-layer-medium" data-depth="14" filter="url(#cloud-blur)">
          <use href="#cloud-b" x="-300" y="210" width="260" height="90" opacity="0.7" /><use href="#cloud-a" x="360" y="240" width="320" height="100" opacity="0.6" /><use href="#cloud-c" x="920" y="195" width="200" height="70" opacity="0.7" />
        </g>
        <g class="cloud-layer cloud-layer-fast" data-depth="26" filter="url(#cloud-blur)">
          <use href="#cloud-c" x="-200" y="380" width="220" height="78" opacity="0.8" /><use href="#cloud-b" x="520" y="410" width="280" height="96" opacity="0.72" /><use href="#cloud-a" x="980" y="395" width="340" height="104" opacity="0.72" />
        </g>
        <rect class="rain-layer" width="1200" height="600" fill="url(#rain-pattern)" />
        <!-- layered horizon silhouette -->
        <g class="hills" data-depth="3">
          <path class="hill hill-far" d="M0 520 Q200 470 420 500 T820 488 T1200 506 V600 H0 Z" />
          <path class="hill hill-near" d="M0 560 Q260 512 520 548 T1020 540 T1200 556 V600 H0 Z" />
        </g>
      </svg>
    </div>

    <div class="hero-content">
      <h1 class="hero-name">Alfie McGlennon</h1>
      <p class="hero-affiliation">MSc Climate Change &amp; AI // University of Reading</p>
      <p class="hero-tag">
        Climate science, machine learning, quantum, and compound risk. From
        copula-based dependence modelling to reinforcement learning on the
        national grid.
      </p>
    </div>

    <div class="weather-readout" data-weather-readout aria-label="Live weather telemetry">
      <span class="wr-dot" aria-hidden="true"></span>
      <span class="wr-label">LIVE</span><span class="wr-sep" aria-hidden="true">·</span>
      <span class="wr-loc">READING</span><span class="wr-sep" aria-hidden="true">·</span>
      <span class="wr-segment" data-readout-temp>--.-°C</span>
      <span class="wr-sep wr-sep-rh" aria-hidden="true">·</span>
      <span class="wr-segment wr-rh" data-readout-rh>-- %RH</span>
      <span class="wr-sep" aria-hidden="true">·</span>
      <span class="wr-segment wr-cond" data-readout-cond>…</span>
      <span class="wr-sep wr-sep-time" aria-hidden="true">·</span>
      <span class="wr-segment wr-time" data-readout-time>UPDATED --:--</span>
    </div>

    <div class="scrollcue" aria-hidden="true"><span>scroll</span><i></i></div>
  </section>

  <!-- About (photo kept) -->
  <section class="page about">
    <div class="about-grid">
      <div class="about-text">
        <p>Hi, I'm Alfie. I'm finishing an MSc in Climate Change and AI at the University of Reading, after a BSc in Meteorology and Climate in the same department. I love a good problem and trying to understand things through a data lens. My dissertation focuses on compound heat stress across Europe: when heat and humidity combine in ways that neither variable alone would predict.</p>
        <p>I'm curious about how things work and why they work the way they do, whether that's atmospheric systems, energy markets, or the assumptions buried inside a model. My work spans machine learning, reinforcement learning, quantum computing, and statistical climatology. <a href="/projects/">Projects</a> has the builds. <a href="/writing/">Writing</a> has the full write-ups.</p>
        <p>If you work in climate risk, reinsurance, operational meteorology, or anywhere statistical and ML methods meet real-world data, I'd like to hear from you. Based in the Reading area.</p>
      </div>
      <figure class="about-photo">
        <img src="/images/alfie.jpg" alt="Alfie McGlennon" width="220" height="275" loading="eager" decoding="async" />
      </figure>
    </div>
    <p class="contact-line">Get in touch: <a id="contact-email" href="#" aria-label="Email Alfie McGlennon">[enable JavaScript to see email]</a></p>
  </section>

  <!-- Jump cards (kept) -->
  <section class="page jump">
    <ul class="jump-cards">
      <li><a href="/research/" class="jump-card"><p class="jump-card-label">Research</p><p class="jump-card-line">Compound heat stress and copula-based risk.</p></a></li>
      <li><a href="/projects/" class="jump-card"><p class="jump-card-label">Projects</p><p class="jump-card-line">Grid dispatch, quantum ML, climate tooling.</p></a></li>
      <li><a href="/writing/" class="jump-card"><p class="jump-card-label">Writing</p><p class="jump-card-line">Full project write-ups, and the thinking behind them.</p></a></li>
      <li><a href="https://alfiemcglennon.github.io/gb-grid-tool/" class="jump-card" target="_blank" rel="noopener noreferrer"><p class="jump-card-label">Grid Tool demo</p><p class="jump-card-line">Browser-based GB transmission grid model.</p></a></li>
      <li><a href="https://github.com/AlfieMcGlennon" class="jump-card" target="_blank" rel="noopener noreferrer"><p class="jump-card-label">GitHub</p><p class="jump-card-line">Open-source builds and side projects.</p></a></li>
      <li><a href="https://www.linkedin.com/in/alfred-mcglennon-927589253/" class="jump-card" target="_blank" rel="noopener noreferrer"><p class="jump-card-label">LinkedIn</p><p class="jump-card-line">Career history and longer-form posts.</p></a></li>
    </ul>
  </section>
</Base>

<style>
  .hero {
    position: relative; width: 100%; height: 100vh; min-height: 540px; overflow: hidden;
    border-bottom: 1px solid var(--rule);
    --sky-top: #b6cfdc; --sky-mid: #e8d4a8; --sky-bot: #ecb37a;
    --sun-opacity: 1; --rain-opacity: 0; --star-opacity: 0;
    --sun-x: 78%; --sun-y: 20%; --sun-col: #ffd78a;
    --px: 0px; --py: 0px; --scrolly: 0px;
  }
  .sky-stop-top { stop-color: var(--sky-top); } .sky-stop-mid { stop-color: var(--sky-mid); } .sky-stop-bot { stop-color: var(--sky-bot); }
  .hero[data-weather="clear"] { --sky-top: #8fbfe0; --sky-mid: #f0d4a0; --sky-bot: #f3b270; --sun-opacity: 1; }
  .hero[data-weather="partly-cloudy"] { --sun-opacity: 0.85; }
  .hero[data-weather="overcast"] { --sky-top: #97a4ae; --sky-mid: #b3bbbf; --sky-bot: #d4c8b4; --sun-opacity: 0.2; }
  .hero[data-weather="rain"] { --sky-top: #6f7c8a; --sky-mid: #8c95a0; --sky-bot: #aba99e; --rain-opacity: 0.24; --sun-opacity: 0; }
  .hero[data-weather="snow"] { --sky-top: #c5d3df; --sky-mid: #dde2e6; --sky-bot: #e7e4d8; --sun-opacity: 0.3; }
  .hero[data-weather="storm"] { --sky-top: #2f3645; --sky-mid: #4c515d; --sky-bot: #6a655c; --rain-opacity: 0.3; --sun-opacity: 0; --star-opacity: 0; }
  .hero[data-weather="night"] { --sky-top: #070f18; --sky-mid: #112233; --sky-bot: #1b2a37; --sun-opacity: 0; --star-opacity: 1; --sun-col: #cdd7e6; }
  .hero[data-cloud-density="low"] .cloud-layer { opacity: 0.5; }
  .hero[data-cloud-density="high"] .cloud-layer { opacity: 1.12; }

  .sky { position: absolute; inset: -6% -3% -3% -3%; will-change: transform;
    transform: translate3d(var(--px), calc(var(--py) + var(--scrolly)), 0); }
  .sky-svg { width: 100%; height: 100%; display: block; }
  .cloud-layer { will-change: transform; transition: opacity 0.7s ease; }
  .cloud-layer-slow { animation: drift-slow 80s linear infinite alternate; }
  .cloud-layer-medium { animation: drift-medium 52s linear infinite alternate; }
  .cloud-layer-fast { animation: drift-fast 34s linear infinite alternate; }
  @keyframes drift-slow { from { transform: translateX(-12%); } to { transform: translateX(12%); } }
  @keyframes drift-medium { from { transform: translateX(-20%); } to { transform: translateX(20%); } }
  @keyframes drift-fast { from { transform: translateX(-30%); } to { transform: translateX(30%); } }

  .celestial { position: absolute; left: var(--sun-x); top: var(--sun-y); width: clamp(90px, 12vw, 150px); height: clamp(90px, 12vw, 150px);
    border-radius: 50%; transform: translate(-50%, -50%); transition: opacity 0.8s ease, left 1.2s ease, top 1.2s ease; will-change: opacity; pointer-events: none; }
  .sun { opacity: var(--sun-opacity); background: radial-gradient(circle at 50% 50%, #fff6df 0%, var(--sun-col) 36%, rgba(255,210,140,0.18) 62%, transparent 72%);
    filter: blur(1px); box-shadow: 0 0 90px 30px rgba(255,214,138,0.35); }
  .moon { opacity: var(--star-opacity); background: radial-gradient(circle at 42% 40%, #f4f7fc 0%, #cdd7e6 55%, rgba(180,196,220,0.15) 72%, transparent 80%);
    box-shadow: 0 0 70px 18px rgba(190,205,230,0.25); }
  .stars { position: absolute; inset: 0; opacity: var(--star-opacity); transition: opacity 1s ease; pointer-events: none;
    background-image:
      radial-gradient(1.4px 1.4px at 12% 18%, #fff, transparent), radial-gradient(1.1px 1.1px at 28% 32%, #dfe7f5, transparent),
      radial-gradient(1.5px 1.5px at 44% 12%, #fff, transparent), radial-gradient(1px 1px at 61% 26%, #cfd9ec, transparent),
      radial-gradient(1.3px 1.3px at 73% 16%, #fff, transparent), radial-gradient(1.1px 1.1px at 86% 30%, #e6edfa, transparent),
      radial-gradient(1px 1px at 19% 44%, #fff, transparent), radial-gradient(1.4px 1.4px at 52% 40%, #fff, transparent),
      radial-gradient(1px 1px at 92% 48%, #d7e0f2, transparent), radial-gradient(1.2px 1.2px at 36% 52%, #fff, transparent);
    animation: twinkle 5s ease-in-out infinite; }
  @keyframes twinkle { 0%,100% { opacity: var(--star-opacity); } 50% { opacity: calc(var(--star-opacity) * 0.6); } }

  .rain-layer { opacity: var(--rain-opacity, 0); transition: opacity 0.7s ease; }
  .hill { transition: fill 0.8s ease; }
  .hill-far { fill: color-mix(in srgb, var(--sky-bot) 70%, #6b5e4a); opacity: 0.5; }
  .hill-near { fill: color-mix(in srgb, var(--sky-bot) 55%, #4a4030); opacity: 0.7; }
  .hero[data-weather="night"] .hill-far { fill: #0d1822; opacity: 0.85; }
  .hero[data-weather="night"] .hill-near { fill: #060e16; opacity: 0.95; }

  .hero-content { position: absolute; inset: 0; z-index: 2; display: flex; flex-direction: column; justify-content: center;
    padding: 0 1.5rem; max-width: 960px; margin: 0 auto; text-align: left; }
  .hero-name { font-family: var(--font-sans); font-weight: 600; font-size: clamp(2.8rem, 8vw, 5.4rem); line-height: 1.02; letter-spacing: -0.025em; color: var(--ink); margin-bottom: 0.85rem; }
  .hero-affiliation { font-family: var(--font-mono); font-size: clamp(0.85rem, 1.4vw, 1.05rem); color: var(--teal-deep); margin-bottom: 0.9rem; }
  .hero-tag { font-family: var(--font-serif); font-style: italic; font-size: clamp(1rem, 1.7vw, 1.25rem); color: var(--ink-dim); max-width: 44ch; line-height: 1.5; }
  .hero[data-weather="night"] .hero-name, .hero[data-weather="storm"] .hero-name { color: #f3efe9; }
  .hero[data-weather="night"] .hero-affiliation { color: #9bd0c8; }
  .hero[data-weather="night"] .hero-tag, .hero[data-weather="storm"] .hero-tag { color: #d6d1c4; }

  .weather-readout { position: absolute; left: 0; right: 0; bottom: 2.6rem; z-index: 3; display: flex; align-items: center;
    justify-content: center; flex-wrap: wrap; gap: 0.5rem; padding: 0.6rem 1rem; font-family: var(--font-mono); font-size: 0.72rem;
    letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-dim); text-shadow: 0 1px 1px rgba(255,255,255,0.4);
    opacity: 0; transform: translateY(6px); transition: opacity 0.5s ease, transform 0.5s ease; }
  .hero.weather-live .weather-readout { opacity: 1; transform: translateY(0); }
  .wr-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--teal); animation: wr-pulse 2s ease-in-out infinite; }
  @keyframes wr-pulse { 0%,100% { opacity: 0.5; transform: scale(0.85); } 50% { opacity: 1; transform: scale(1.18); } }
  .wr-label, .wr-loc { color: var(--teal-deep); font-weight: 600; } .wr-sep { color: var(--ink-faint); opacity: 0.6; }
  .hero[data-weather="night"] .weather-readout, .hero[data-weather="storm"] .weather-readout, .hero[data-weather="rain"] .weather-readout { color: #ece8de; text-shadow: 0 1px 2px rgba(0,0,0,0.5); }
  .hero[data-weather="night"] .wr-label, .hero[data-weather="night"] .wr-loc, .hero[data-weather="storm"] .wr-label, .hero[data-weather="storm"] .wr-loc, .hero[data-weather="rain"] .wr-label, .hero[data-weather="rain"] .wr-loc { color: #7fd3c4; }

  .scrollcue { position: absolute; bottom: 1rem; left: 50%; transform: translateX(-50%); z-index: 3; display: flex; flex-direction: column; align-items: center; gap: 0.4rem;
    font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.28em; text-transform: uppercase; color: var(--ink-faint); }
  .scrollcue i { width: 1px; height: 30px; background: linear-gradient(var(--ink-faint), transparent); animation: cue 2.2s ease-in-out infinite; }
  @keyframes cue { 0% { transform: scaleY(0); transform-origin: top; } 50% { transform: scaleY(1); transform-origin: top; } 51% { transform-origin: bottom; } 100% { transform: scaleY(0); transform-origin: bottom; } }

  @media (prefers-reduced-motion: reduce) {
    .cloud-layer, .stars, .wr-dot, .scrollcue i { animation: none; }
    .sky { transform: none; }
  }

  /* About + jump (kept from the live homepage) */
  .about-grid { display: grid; grid-template-columns: 1fr; gap: 2.25rem; align-items: start; }
  @media (min-width: 760px) { .about-grid { grid-template-columns: 1fr 200px; gap: 2.5rem; } }
  .about-text p { margin-bottom: 1.1rem; }
  .about-photo { margin: 0; width: 100%; max-width: 220px; }
  .about-photo img { display: block; width: 100%; aspect-ratio: 4/5; object-fit: cover; object-position: center top; border: 1px solid var(--rule); border-radius: 4px; background: var(--bg-raised); }
  .contact-line { text-align: center; font-family: var(--font-mono); font-size: 0.95rem; padding: 2rem 1.5rem 0.5rem; margin: 0; letter-spacing: 0.04em; }
  .contact-line a { color: var(--teal-deep); font-weight: 600; text-decoration: none; border-bottom: 1.5px solid var(--teal); padding: 0.15rem 0.1rem 0.25rem; }
  .contact-line a:hover { color: var(--amber); border-bottom-color: var(--amber); }
  .jump { padding-top: 0; }
  .jump-cards { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr; grid-auto-rows: 1fr; border-top: 1px solid var(--rule); }
  .jump-cards li { display: flex; }
  @media (min-width: 560px) { .jump-cards { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 900px) { .jump-cards { grid-template-columns: 1fr 1fr 1fr; } }
  .jump-card { display: flex; flex-direction: column; width: 100%; min-height: 6.5rem; padding: 1.4rem 1.1rem; border-bottom: 1px solid var(--rule); color: var(--ink); text-decoration: none; transition: background 0.2s ease; }
  .jump-card:hover { background: var(--bg-raised); }
  @media (min-width: 560px) and (max-width: 899px) { .jump-cards li:nth-child(even) .jump-card { border-left: 1px solid var(--rule); } }
  @media (min-width: 900px) { .jump-cards li .jump-card { border-left: 1px solid var(--rule); } .jump-cards li:nth-child(3n+1) .jump-card { border-left: 0; } }
  .jump-card-label { font-family: var(--font-sans); font-weight: 600; font-size: 1.02rem; color: var(--teal-deep); margin: 0 0 0.35rem; }
  .jump-card:hover .jump-card-label { color: var(--amber); }
  .jump-card-line { font-family: var(--font-serif); font-size: 0.95rem; color: var(--ink-muted); margin: 0; line-height: 1.45; }
</style>

<script>
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* live weather (kept) + day/night celestial position */
  (async function initWeatherHero() {
    const hero = document.querySelector('[data-hero]');
    if (!hero) return;
    const CACHE_KEY = 'weather-reading-v1', TTL_MS = 30 * 60 * 1000;
    const URL = 'https://api.open-meteo.com/v1/forecast?latitude=51.4543&longitude=-0.9781&current=temperature_2m,relative_humidity_2m,wind_speed_10m,cloud_cover,weather_code,is_day&timezone=Europe/London';
    const codeToLabel = (c, isDay) => {
      if (c === 0) return isDay ? 'CLEAR SKY' : 'CLEAR NIGHT'; if (c === 1) return 'MOSTLY CLEAR'; if (c === 2) return 'PARTLY CLOUDY';
      if (c === 3) return 'OVERCAST'; if (c === 45 || c === 48) return 'FOG'; if (c >= 51 && c <= 57) return 'DRIZZLE';
      if (c >= 61 && c <= 67) return 'RAIN'; if (c >= 71 && c <= 77) return 'SNOW'; if (c >= 80 && c <= 82) return 'RAIN SHOWERS';
      if (c === 85 || c === 86) return 'SNOW SHOWERS'; if (c >= 95 && c <= 99) return 'THUNDERSTORM'; return 'LIVE';
    };
    const fmtClock = (d) => d.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: 'Europe/London' });
    function applyWeather(payload) {
      const c = payload.current || payload;
      const code = c.weather_code ?? 2, isDay = c.is_day ?? 1, cloudCover = c.cloud_cover ?? 50, temp = c.temperature_2m ?? 15;
      let state = 'partly-cloudy';
      if (isDay === 0) state = 'night'; else if (code === 0 || code === 1) state = 'clear'; else if (code === 2) state = 'partly-cloudy';
      else if (code === 3 || code === 45 || code === 48) state = 'overcast';
      else if ((code >= 51 && code <= 67) || (code >= 80 && code <= 82)) state = 'rain';
      else if ((code >= 71 && code <= 77) || code === 85 || code === 86) state = 'snow';
      else if (code >= 95 && code <= 99) state = 'storm';
      hero.dataset.weather = state;
      hero.dataset.cloudDensity = cloudCover < 25 ? 'low' : cloudCover > 70 ? 'high' : 'mid';
      // place the sun/moon by local hour (arc across the sky)
      const hourNow = new Date().toLocaleString('en-GB', { hour: '2-digit', hour12: false, timeZone: 'Europe/London' });
      const hr = parseInt(hourNow, 10) || 12;
      const frac = Math.min(1, Math.max(0, (hr - 6) / 12)); // 6am→6pm across
      hero.style.setProperty('--sun-x', (14 + frac * 72) + '%');
      hero.style.setProperty('--sun-y', (46 - Math.sin(frac * Math.PI) * 30) + '%');
      hero.classList.add('weather-live');
      const humidity = c.relative_humidity_2m ?? null, fetchedAt = payload.fetchedAt ? new Date(payload.fetchedAt) : new Date();
      const q = (s) => hero.querySelector(s);
      const tempEl = q('[data-readout-temp]'), rhEl = q('[data-readout-rh]'), condEl = q('[data-readout-cond]'), timeEl = q('[data-readout-time]');
      if (tempEl) tempEl.textContent = `${temp.toFixed(1)}°C`;
      if (rhEl) rhEl.textContent = humidity != null ? `${Math.round(humidity)} %RH` : '-- %RH';
      if (condEl) condEl.textContent = codeToLabel(code, isDay);
      if (timeEl) timeEl.textContent = `UPDATED ${fmtClock(fetchedAt)}`;
    }
    try { const cached = sessionStorage.getItem(CACHE_KEY); if (cached) { const p = JSON.parse(cached); if (Date.now() - p.timestamp < TTL_MS) { applyWeather({ ...p.data, fetchedAt: p.timestamp }); return; } } } catch (e) {}
    try {
      const ctrl = new AbortController(); const timer = setTimeout(() => ctrl.abort(), 2000);
      const res = await fetch(URL, { signal: ctrl.signal }); clearTimeout(timer); if (!res.ok) throw 0;
      const data = await res.json(); const fetchedAt = Date.now();
      try { sessionStorage.setItem(CACHE_KEY, JSON.stringify({ data, timestamp: fetchedAt })); } catch (e) {}
      applyWeather({ ...data, fetchedAt });
    } catch (e) { hero.classList.add('weather-live'); }
  })();

  /* parallax: clouds/hills shift with mouse + scroll for depth */
  if (!reduced) {
    const hero = document.querySelector('[data-hero]');
    const sky = hero && hero.querySelector('[data-parallax]');
    const layers = hero ? Array.from(hero.querySelectorAll('.hills')) : []; // cloud layers keep their CSS drift
    if (hero && sky) {
      let mx = 0, my = 0, raf = 0;
      function apply() {
        raf = 0;
        hero.style.setProperty('--px', (mx * 18).toFixed(1) + 'px');
        hero.style.setProperty('--py', (my * 12).toFixed(1) + 'px');
        layers.forEach((l) => { const d = +l.dataset.depth || 0; l.style.transform = `translate(${(mx * d).toFixed(1)}px, ${(my * d * 0.6).toFixed(1)}px)`; });
      }
      window.addEventListener('pointermove', (e) => {
        mx = (e.clientX / window.innerWidth - 0.5) * 2; my = (e.clientY / window.innerHeight - 0.5) * 2;
        if (!raf) raf = requestAnimationFrame(apply);
      }, { passive: true });
      let sraf = 0;
      window.addEventListener('scroll', () => { if (sraf) return; sraf = requestAnimationFrame(() => { sraf = 0; const y = Math.min(window.scrollY, window.innerHeight); hero.style.setProperty('--scrolly', (y * 0.28).toFixed(1) + 'px'); }); }, { passive: true });
    }
  }

  /* email */
  (function () { const el = document.getElementById('contact-email'); if (!el) return; el.href = 'mailto:alfie@alfiemcglennon.com'; el.textContent = 'alfie@alfiemcglennon.com'; })();
</script>
