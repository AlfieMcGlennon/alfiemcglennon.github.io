---
// HeroAlmanac.astro — Hero Lab variant 2: the conservative, "cleaner and
// more striking" option. A hand-drawn line-art condition glyph (one shared
// cloud silhouette, consistent stroke weight, reused across the 8 WMO
// buckets) plus an aligned mono instrument panel with dotted leaders. Motion
// is deliberately almost absent: the wind vane rotates to the true
// wind_direction_10m, and a small precipitation tick row only animates while
// it is actually precipitating in Reading.
---

<section
  class="lab-hero lab-hero-almanac"
  data-hero-variant="almanac"
  data-lab-panel="almanac"
  hidden
  aria-label="Almanac hero variant"
>
  <!-- Shared line-art glyph sprite, keyed to the 8 WMO condition buckets
       (with separate day/night faces for clear + partly-cloudy). Every
       glyph reuses one cloud silhouette so the set reads as one family. -->
  <svg class="wx-sprite" aria-hidden="true" focusable="false">
    <defs>
      <symbol id="wx-clear-day" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="32" cy="32" r="11" />
        <line x1="48" y1="32" x2="55" y2="32" />
        <line x1="43" y1="43" x2="48" y2="48" />
        <line x1="32" y1="48" x2="32" y2="55" />
        <line x1="21" y1="43" x2="16" y2="48" />
        <line x1="16" y1="32" x2="9" y2="32" />
        <line x1="21" y1="21" x2="16" y2="16" />
        <line x1="32" y1="16" x2="32" y2="9" />
        <line x1="43" y1="21" x2="48" y2="16" />
      </symbol>

      <symbol id="wx-clear-night" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
        <path d="M56 34.1A24 24 0 1 1 29.9 8 18.7 18.7 0 0 0 56 34.1z" />
      </symbol>

      <symbol id="wx-partly-cloudy-day" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="22" cy="20" r="7" />
        <line x1="13" y1="17" x2="10" y2="16" />
        <line x1="17" y1="13" x2="15" y2="9" />
        <line x1="22" y1="11" x2="22" y2="7" />
        <line x1="27" y1="13" x2="30" y2="9" />
        <g transform="translate(6 10) scale(0.82)">
          <path d="M18 46 L46 46 C54 46 58 42 58 36 C58 29 52 25 46 26 C44 16 34 10 26 14 C20 15 14 18 12 24 C6 25 4 31 6 37 C7 42 12 46 18 46 Z" />
        </g>
      </symbol>

      <symbol id="wx-partly-cloudy-night" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
        <g transform="translate(2 1) scale(0.5)">
          <path d="M56 34.1A24 24 0 1 1 29.9 8 18.7 18.7 0 0 0 56 34.1z" />
        </g>
        <g transform="translate(6 10) scale(0.82)">
          <path d="M18 46 L46 46 C54 46 58 42 58 36 C58 29 52 25 46 26 C44 16 34 10 26 14 C20 15 14 18 12 24 C6 25 4 31 6 37 C7 42 12 46 18 46 Z" />
        </g>
      </symbol>

      <symbol id="wx-overcast" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
        <g transform="translate(-2 -2) scale(1.08)">
          <path d="M18 46 L46 46 C54 46 58 42 58 36 C58 29 52 25 46 26 C44 16 34 10 26 14 C20 15 14 18 12 24 C6 25 4 31 6 37 C7 42 12 46 18 46 Z" />
        </g>
        <path d="M8 52 Q32 58 56 52" />
      </symbol>

      <symbol id="wx-fog" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
        <g transform="translate(0 -8) scale(0.88)">
          <path d="M18 46 L46 46 C54 46 58 42 58 36 C58 29 52 25 46 26 C44 16 34 10 26 14 C20 15 14 18 12 24 C6 25 4 31 6 37 C7 42 12 46 18 46 Z" />
        </g>
        <path d="M8 50 q7 -6 14 0 q7 6 14 0 q7 -6 14 0" />
        <path d="M12 58 q6 -5 12 0 q6 5 12 0 q6 -5 12 0" />
      </symbol>

      <symbol id="wx-drizzle" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
        <g transform="translate(0 -4) scale(0.95)">
          <path d="M18 46 L46 46 C54 46 58 42 58 36 C58 29 52 25 46 26 C44 16 34 10 26 14 C20 15 14 18 12 24 C6 25 4 31 6 37 C7 42 12 46 18 46 Z" />
        </g>
        <line x1="20" y1="49" x2="17" y2="57" />
        <line x1="32" y1="49" x2="29" y2="57" />
        <line x1="44" y1="49" x2="41" y2="57" />
      </symbol>

      <symbol id="wx-rain" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
        <g transform="translate(0 -4) scale(0.95)">
          <path d="M18 46 L46 46 C54 46 58 42 58 36 C58 29 52 25 46 26 C44 16 34 10 26 14 C20 15 14 18 12 24 C6 25 4 31 6 37 C7 42 12 46 18 46 Z" />
        </g>
        <line x1="14" y1="49" x2="9" y2="61" />
        <line x1="26" y1="49" x2="21" y2="61" />
        <line x1="38" y1="49" x2="33" y2="61" />
        <line x1="50" y1="49" x2="45" y2="61" />
      </symbol>

      <symbol id="wx-snow" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
        <g transform="translate(0 -4) scale(0.95)">
          <path d="M18 46 L46 46 C54 46 58 42 58 36 C58 29 52 25 46 26 C44 16 34 10 26 14 C20 15 14 18 12 24 C6 25 4 31 6 37 C7 42 12 46 18 46 Z" />
        </g>
        <path d="M14 54h8M18 50v8" />
        <path d="M28 56h8M32 52v8" />
        <path d="M42 54h8M46 50v8" />
      </symbol>

      <symbol id="wx-thunderstorm" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
        <g transform="translate(0 -4) scale(0.95)">
          <path d="M18 46 L46 46 C54 46 58 42 58 36 C58 29 52 25 46 26 C44 16 34 10 26 14 C20 15 14 18 12 24 C6 25 4 31 6 37 C7 42 12 46 18 46 Z" />
        </g>
        <path d="M33 47 L27 57 L32 57 L27 63" />
      </symbol>
    </defs>
  </svg>

  <div class="almanac-layout">
    <div class="lab-hero-content">
      <h2 class="lab-hero-name">Alfie McGlennon</h2>
      <p class="lab-hero-affiliation">MSc Climate Change &amp; AI // University of Reading</p>
      <p class="lab-hero-tag">
        Climate science, machine learning, quantum, and compound risk.
        From copula-based dependence modelling to reinforcement learning on
        the national grid.
      </p>
      <p class="lab-hero-cta">
        <a href="/research/">Research</a>
        <a href="/projects/">Projects</a>
        <a href="/writing/">Writing</a>
      </p>
    </div>

    <div class="almanac-panel" data-wx-panel aria-label="Live weather telemetry">
      <div class="ap-head">
        <svg class="almanac-glyph" viewBox="0 0 64 64" aria-hidden="true">
          <use data-almanac-glyph-use href="#wx-partly-cloudy-day" xlink:href="#wx-partly-cloudy-day"></use>
        </svg>
        <div class="ap-head-text">
          <p class="ap-cond" data-wx-cond>&hellip;</p>
          <p class="ap-status">
            <span data-wx-status>STATIC</span> &middot; READING &middot; <span data-wx-time>UPDATED --:--</span>
          </p>
        </div>
      </div>

      <dl class="almanac-grid">
        <div class="ag-row"><dt>Temp</dt><span class="ag-leader" aria-hidden="true"></span><dd data-wx-temp>--.-&deg;C</dd></div>
        <div class="ag-row"><dt>Feels like</dt><span class="ag-leader" aria-hidden="true"></span><dd data-wx-feels>--.-&deg;C</dd></div>
        <div class="ag-row"><dt>Dew point</dt><span class="ag-leader" aria-hidden="true"></span><dd data-wx-dew>--.-&deg;C</dd></div>
        <div class="ag-row"><dt>Humidity</dt><span class="ag-leader" aria-hidden="true"></span><dd data-wx-rh>--%</dd></div>
        <div class="ag-row ag-wind">
          <dt>Wind</dt>
          <span class="ag-leader" aria-hidden="true"></span>
          <dd>
            <svg class="wind-vane" viewBox="0 0 32 32" aria-hidden="true">
              <circle cx="16" cy="16" r="13" fill="none" stroke="currentColor" stroke-width="1.2" opacity="0.35" />
              <text x="16" y="6.5" font-size="6" text-anchor="middle" fill="currentColor" opacity="0.55">N</text>
              <g data-wx-vane style="transform-origin: 16px 16px;">
                <line x1="16" y1="16" x2="16" y2="5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                <circle cx="16" cy="16" r="2" fill="currentColor" />
              </g>
            </svg>
            <span data-wx-wind>-- KM/H --</span>
          </dd>
        </div>
        <div class="ag-row"><dt>MSLP</dt><span class="ag-leader" aria-hidden="true"></span><dd data-wx-pressure>---- HPA</dd></div>
      </dl>

      <div class="precip-row">
        <span class="precip-label">Precip.</span>
        <div class="precip-ticks" data-precip-ticks aria-hidden="true">
          <span></span><span></span><span></span><span></span><span></span>
        </div>
        <span class="precip-value" data-wx-precip>0.0 MM</span>
      </div>

      <p class="ap-foot">
        <a href="https://open-meteo.com" target="_blank" rel="noopener noreferrer">OPEN-METEO</a>
      </p>
    </div>
  </div>
</section>

<script>
  import { paintTelemetry } from '../scripts/weather.js';
  import { subscribe } from '../scripts/hero-lab-state.js';
  import { initAlmanac } from '../scripts/hero-lab-almanac.js';

  function boot() {
    const root = document.querySelector('[data-hero-variant="almanac"]');
    if (!root) return;
    const renderer = initAlmanac(root);
    // Re-runs on the live fetch AND on every lab-only override — see
    // src/scripts/hero-lab-state.js.
    subscribe((reading) => {
      if (!reading) return;
      paintTelemetry(root, reading);
      if (renderer) renderer.setData(reading);
    });
  }

  boot();
</script>

<style>
  .wx-sprite {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  .lab-hero-almanac {
    position: relative;
    width: 100%;
    min-height: clamp(380px, 60vh, 560px);
    overflow: hidden;
    border-bottom: 1px solid var(--rule);
    background: var(--bg-raised);
    display: flex;
    align-items: center;
    padding: 2.5rem 0;
  }

  /* An explicit `display` on the section above beats the UA stylesheet's
     [hidden] { display: none } (author origin always wins over UA origin,
     regardless of specificity), so the switcher's `hidden` attribute would
     otherwise be silently ignored here. Restate it with higher specificity. */
  .lab-hero-almanac[hidden] {
    display: none;
  }

  .almanac-layout {
    width: 100%;
    max-width: 1040px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.25rem;
    align-items: center;
  }

  @media (min-width: 860px) {
    .almanac-layout {
      grid-template-columns: 1.25fr 1fr;
      gap: 3rem;
    }
  }

  .lab-hero-name {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: clamp(2.2rem, 5.6vw, 3.4rem);
    line-height: 1.05;
    letter-spacing: -0.022em;
    color: var(--ink);
    margin-bottom: 0.85rem;
  }

  .lab-hero-affiliation {
    font-family: var(--font-mono);
    font-size: clamp(0.85rem, 1.4vw, 1rem);
    color: var(--teal-deep);
    margin-bottom: 0.85rem;
    letter-spacing: 0.01em;
  }

  .lab-hero-tag {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1rem, 1.7vw, 1.15rem);
    color: var(--ink-dim);
    max-width: 42ch;
    line-height: 1.45;
    margin-bottom: 1.1rem;
  }

  .lab-hero-cta {
    display: flex;
    gap: 1.4rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .lab-hero-cta a {
    color: var(--teal-deep);
    border-bottom: 1px dotted var(--teal);
    padding-bottom: 2px;
  }

  .lab-hero-cta a:hover {
    color: var(--teal);
    border-bottom-color: var(--teal);
  }

  .almanac-panel {
    background: var(--bg);
    border: 1px solid var(--rule);
    border-radius: 8px;
    padding: 1.4rem 1.5rem 1.2rem;
    font-family: var(--font-mono);
  }

  .ap-head {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding-bottom: 0.9rem;
    margin-bottom: 0.9rem;
    border-bottom: 1px solid var(--rule);
  }

  .almanac-glyph {
    width: 46px;
    height: 46px;
    flex-shrink: 0;
    color: var(--teal-deep);
    transition: opacity 0.14s ease;
  }

  .almanac-glyph.is-swapping {
    opacity: 0;
  }

  .ap-head-text {
    min-width: 0;
  }

  .ap-cond {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 1rem;
    color: var(--ink);
    margin: 0 0 0.2rem;
    letter-spacing: -0.005em;
  }

  .ap-status {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-faint);
    margin: 0;
  }

  .ap-status span:first-child {
    color: var(--teal-deep);
    font-weight: 600;
  }

  .wx-override .ap-status span:first-child {
    color: var(--amber);
  }

  .almanac-grid {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    margin: 0 0 0.9rem;
  }

  .ag-row {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .ag-row dt {
    font-size: 0.76rem;
    color: var(--ink-muted);
    white-space: nowrap;
  }

  .ag-leader {
    flex: 1 1 auto;
    border-bottom: 1px dotted var(--rule);
    margin-bottom: 0.3em;
    min-width: 0.75rem;
  }

  .ag-row dd {
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--ink);
    margin: 0;
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .wind-vane {
    width: 20px;
    height: 20px;
    color: var(--teal-deep);
    flex-shrink: 0;
  }

  .wind-vane [data-wx-vane] {
    transition: transform 0.7s cubic-bezier(0.34, 1.2, 0.4, 1);
  }

  .precip-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.72rem;
    color: var(--ink-muted);
    padding-top: 0.7rem;
    border-top: 1px solid var(--rule);
  }

  .precip-label {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.66rem;
    color: var(--ink-faint);
  }

  .precip-ticks {
    display: flex;
    gap: 3px;
    flex: 1;
  }

  .precip-ticks span {
    width: 3px;
    height: 10px;
    border-radius: 2px;
    background: var(--rule);
    opacity: 0.6;
  }

  .precip-ticks.is-active span {
    background: var(--teal);
    opacity: 0.9;
    animation: precip-tick 1.4s ease-in-out infinite;
  }

  .precip-ticks.is-active.is-paused span {
    animation-play-state: paused;
  }

  .precip-ticks.is-active span:nth-child(1) { animation-delay: 0s; }
  .precip-ticks.is-active span:nth-child(2) { animation-delay: 0.12s; }
  .precip-ticks.is-active span:nth-child(3) { animation-delay: 0.24s; }
  .precip-ticks.is-active span:nth-child(4) { animation-delay: 0.36s; }
  .precip-ticks.is-active span:nth-child(5) { animation-delay: 0.48s; }

  @keyframes precip-tick {
    0%, 100% { transform: scaleY(1); opacity: 0.5; }
    50% { transform: scaleY(1.6); opacity: 1; }
  }

  .precip-value {
    color: var(--ink);
    font-weight: 600;
    white-space: nowrap;
  }

  .ap-foot {
    margin: 0.9rem 0 0;
    text-align: right;
    font-size: 0.66rem;
  }

  .ap-foot a {
    color: var(--teal-deep);
    border-bottom: 1px dotted var(--teal);
  }

  @media (prefers-reduced-motion: reduce) {
    .wind-vane [data-wx-vane] { transition: none; }
    .precip-ticks.is-active span { animation: none; opacity: 0.85; }
  }
</style>
