---
// HeroSynoptic.astro — Hero Lab variant 1: a drifting isoline field on a
// <canvas>, styled like a synoptic pressure chart, sitting behind the hero
// copy. Contour spacing/amplitude and drift are driven by real Reading
// telemetry (see src/scripts/hero-lab-synoptic.js); the mono instrument
// panel is the "clean instrument cluster" the brief asks for, including
// dew point and MSLP. Self-contained: only used on /hero-lab.
---

<section
  class="lab-hero lab-hero-synoptic"
  data-hero-variant="synoptic"
  data-lab-panel="synoptic"
  hidden
  aria-label="Synoptic hero variant"
>
  <canvas class="synoptic-canvas" data-synoptic-canvas aria-hidden="true"></canvas>

  <div class="lab-hero-content">
    <h2 class="lab-hero-name">Alfie McGlennon</h2>
    <p class="lab-hero-affiliation">MSc Climate Change &amp; AI // University of Reading</p>
    <p class="lab-hero-tag">
      Climate science, machine learning, quantum, and compound risk.
      From copula-based dependence modelling to reinforcement learning on
      the national grid.
    </p>
    <p class="lab-hero-cta">
      <a href="/research/">Research</a>
      <a href="/projects/">Projects</a>
      <a href="/writing/">Writing</a>
    </p>
  </div>

  <div class="synoptic-panel" data-wx-panel aria-label="Live weather telemetry">
    <div class="sp-head">
      <span class="sp-dot" aria-hidden="true"></span>
      <span class="sp-status" data-wx-status>STATIC</span>
      <span class="sp-sep">&middot;</span>
      <span class="sp-loc">READING</span>
      <span class="sp-sep">&middot;</span>
      <span class="sp-cond" data-wx-cond>&hellip;</span>
    </div>
    <dl class="sp-grid">
      <div><dt>Temp</dt><dd data-wx-temp>--.-&deg;C</dd></div>
      <div><dt>Feels</dt><dd data-wx-feels>--.-&deg;C</dd></div>
      <div><dt>Dew pt</dt><dd data-wx-dew>--.-&deg;C</dd></div>
      <div><dt>Humidity</dt><dd data-wx-rh>--%</dd></div>
      <div><dt>Wind</dt><dd data-wx-wind>-- KM/H --</dd></div>
      <div><dt>MSLP</dt><dd data-wx-pressure>---- HPA</dd></div>
    </dl>
    <p class="sp-foot">
      <span data-wx-time>UPDATED --:--</span>
      <span class="sp-sep">&middot;</span>
      <a href="https://open-meteo.com" target="_blank" rel="noopener noreferrer">OPEN-METEO</a>
    </p>
  </div>
</section>

<script>
  import { paintTelemetry } from '../scripts/weather.js';
  import { subscribe } from '../scripts/hero-lab-state.js';
  import { initSynoptic } from '../scripts/hero-lab-synoptic.js';

  function boot() {
    const root = document.querySelector('[data-hero-variant="synoptic"]');
    if (!root) return;
    const renderer = initSynoptic(root);
    // Re-runs on the live fetch AND on every lab-only override — see
    // src/scripts/hero-lab-state.js.
    subscribe((reading) => {
      if (!reading) return;
      paintTelemetry(root, reading);
      if (renderer) renderer.setData(reading);
    });
  }

  boot();
</script>

<style>
  .lab-hero-synoptic {
    position: relative;
    width: 100%;
    height: clamp(380px, 60vh, 560px);
    overflow: hidden;
    border-bottom: 1px solid var(--rule);
    background: var(--bg-raised);
  }

  .synoptic-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .lab-hero-content {
    position: relative;
    z-index: 2;
    max-width: 920px;
    margin: 0 auto;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0 1.5rem;
  }

  .lab-hero-name {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: clamp(2.4rem, 6.5vw, 4rem);
    line-height: 1.05;
    letter-spacing: -0.022em;
    color: var(--ink);
    margin-bottom: 0.85rem;
  }

  .lab-hero-affiliation {
    font-family: var(--font-mono);
    font-size: clamp(0.85rem, 1.4vw, 1rem);
    color: var(--teal-deep);
    margin-bottom: 0.85rem;
    letter-spacing: 0.01em;
  }

  .lab-hero-tag {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1rem, 1.7vw, 1.2rem);
    color: var(--ink-dim);
    max-width: 42ch;
    line-height: 1.45;
    margin-bottom: 1.1rem;
  }

  .lab-hero-cta {
    display: flex;
    gap: 1.4rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .lab-hero-cta a {
    color: var(--teal-deep);
    border-bottom: 1px dotted var(--teal);
    padding-bottom: 2px;
  }

  .lab-hero-cta a:hover {
    color: var(--teal);
    border-bottom-color: var(--teal);
  }

  .synoptic-panel {
    position: absolute;
    left: 1.5rem;
    bottom: 1.4rem;
    z-index: 3;
    width: min(320px, calc(100% - 3rem));
    padding: 0.9rem 1rem 0.8rem;
    background: color-mix(in srgb, var(--bg-raised) 88%, transparent);
    border: 1px solid var(--rule);
    border-radius: 6px;
    backdrop-filter: blur(3px);
    font-family: var(--font-mono);
  }

  .sp-head {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-muted);
    margin-bottom: 0.6rem;
    flex-wrap: wrap;
  }

  .sp-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--teal);
    flex-shrink: 0;
  }

  .wx-live .sp-dot {
    animation: sp-pulse 2s ease-in-out infinite;
  }

  @keyframes sp-pulse {
    0%, 100% { opacity: 0.5; transform: scale(0.85); }
    50% { opacity: 1; transform: scale(1.18); }
  }

  .sp-status,
  .sp-loc {
    color: var(--teal-deep);
    font-weight: 600;
  }

  .wx-override .sp-status {
    color: var(--amber);
  }

  .sp-sep {
    color: var(--ink-faint);
  }

  .sp-cond {
    color: var(--ink-dim);
  }

  .sp-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.45rem 0.9rem;
    margin: 0 0 0.7rem;
  }

  .sp-grid div {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    border-bottom: 1px solid var(--rule-soft);
    padding-bottom: 0.2rem;
  }

  .sp-grid dt {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-faint);
  }

  .sp-grid dd {
    font-size: 0.82rem;
    color: var(--ink);
    font-weight: 600;
    margin: 0;
  }

  .sp-foot {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    color: var(--ink-faint);
    margin: 0;
  }

  .sp-foot a {
    color: var(--teal-deep);
    border-bottom: 1px dotted var(--teal);
  }

  @media (max-width: 640px) {
    .synoptic-panel {
      left: 1rem;
      right: 1rem;
      bottom: 1rem;
      width: auto;
    }
    .sp-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sp-dot { animation: none; }
  }
</style>
