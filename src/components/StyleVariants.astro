---
// StyleVariants.astro — a per-post style switcher (intro post only).
//
// Lets a reader compare three stylisations of THIS page and pick one:
//   - Parchment : the on-brand warm-light default (no overrides)
//   - Lab       : a sober dark "instrument" theme (slate, brighter indigo arrow)
//   - Kinetic   : a bolder editorial treatment (display headings, accent edges,
//                 a header entrance + a scroll progress bar)
//
// It is pure presentation: it only sets data-variant on <html>, persists the
// choice, and dispatches a 'variantchange' event so the canvas figures re-read
// the theme. Everything degrades to Parchment with no JS, and every flourish is
// gated on prefers-reduced-motion. It also owns the page's one-shot figure
// reveals (reveal.js). Scoped to this post because only this post imports it,
// so its CSS/JS never ship on other pages.
---

<div class="variant-switch" role="group" aria-label="Page style" data-variant-switch>
  <span class="vs-label">Style</span>
  <button type="button" data-variant-set="parchment" aria-pressed="true">Parchment</button>
  <button type="button" data-variant-set="lab" aria-pressed="false">Lab</button>
  <button type="button" data-variant-set="kinetic" aria-pressed="false">Kinetic</button>
</div>

<a class="vs-showcase" href="/lab/quantum/">&#10022; See the Lab showcase &rarr;</a>

<div class="kinetic-progress" data-kinetic-progress hidden aria-hidden="true"></div>

<style is:global>
  /* ── Switcher chrome (themed via tokens, so it adapts to each variant) ── */
  .variant-switch {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    flex-wrap: wrap;
    width: fit-content;
    margin: 0 0 2.25rem;
    padding: 0.4rem 0.5rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--bg-raised);
  }
  .vs-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--ink-faint);
    padding: 0 0.5rem 0 0.4rem;
  }
  .variant-switch button {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    cursor: pointer;
    background: none;
    color: var(--ink-muted);
    border: 1px solid transparent;
    border-radius: 999px;
    padding: 0.28rem 0.85rem;
    transition: color 0.18s ease, background 0.18s ease, border-color 0.18s ease;
  }
  .variant-switch button:hover { color: var(--ink); }
  .variant-switch button[aria-pressed="true"] {
    color: var(--accent);
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }

  .vs-showcase {
    display: inline-flex; align-items: center; gap: 0.4rem;
    margin: -1.6rem 0 2.4rem;
    font-family: var(--font-mono); font-size: 0.76rem;
    color: var(--accent); border-bottom: 0;
  }
  .vs-showcase:hover { color: var(--ink); }

  /* ── Reading-progress bar (Kinetic only; toggled by JS, reader-driven) ── */
  .kinetic-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left center;
    z-index: 60;
    will-change: transform;
    pointer-events: none;
  }

  /* ════════════════ LAB: dark technical instrument theme ════════════════ */
  html[data-variant="lab"] {
    --bg: #0e1116;
    --bg-raised: #161b22;
    --rule: #2a313c;
    --rule-soft: #20262f;
    --ink: #e6e8ec;
    --ink-dim: #c4c9d2;
    --ink-muted: #8b94a3;
    --ink-faint: #5e6675;
    --teal: #2dd4bf;
    --teal-deep: #5eead4;
    --teal-soft: #0f3b37;
    --amber: #fbbf24;
    --amber-soft: #5a3a12;
    --accent: #818cf8;
    --arrow: #a5b4fc; /* brighter state-vector indigo, read by bloch.js */
  }
  /* Beat the per-project --accent set on the <article>. */
  html[data-variant="lab"] [data-project] { --accent: #818cf8; }
  /* Links read brighter teal already; keep code/pre legible on slate. */
  html[data-variant="lab"] pre { border-left-color: var(--accent); }

  /* ════════════════ KINETIC: bolder editorial treatment ════════════════ */
  html[data-variant="kinetic"] {
    --bg: #faf9f6;
    --bg-raised: #ffffff;
    --rule: #e6e0d5;
    --accent: #4f46e5;
  }
  html[data-variant="kinetic"] [data-project] { --accent: #4f46e5; }
  html[data-variant="kinetic"] .post h1 {
    font-size: clamp(2.5rem, 6.5vw, 3.6rem);
    letter-spacing: -0.035em;
    line-height: 1.04;
  }
  html[data-variant="kinetic"] .post .kicker { color: var(--accent); }
  html[data-variant="kinetic"] .post .lede { font-size: 1.3rem; }
  html[data-variant="kinetic"] .post-body h2 {
    position: relative;
    padding-left: 1rem;
  }
  html[data-variant="kinetic"] .post-body h2::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.18em;
    bottom: 0.18em;
    width: 4px;
    border-radius: 2px;
    background: var(--accent);
  }
  html[data-variant="kinetic"] .qarrow,
  html[data-variant="kinetic"] .twowaves {
    border-left: 3px solid var(--accent);
  }
</style>

<script>
  import { animate, stagger } from 'animejs';
  import { prefersReducedMotion } from '../scripts/scrolly.js';
  import { attachReveals } from '../scripts/reveal.js';

  const VARIANTS = ['parchment', 'lab', 'kinetic'];
  const KEY = 'intro-style-variant';
  let progressHandler = null;

  function runHeaderEntrance() {
    if (prefersReducedMotion()) return;
    const els = document.querySelectorAll('.post-head > *');
    if (!els.length) return;
    animate(els, {
      opacity: [0, 1],
      translateY: [14, 0],
      duration: 600,
      ease: 'out(3)',
      delay: stagger(80),
    });
  }

  function setupKinetic(v) {
    const bar = document.querySelector('[data-kinetic-progress]');
    if (!bar) return;
    if (progressHandler) {
      window.removeEventListener('scroll', progressHandler);
      window.removeEventListener('resize', progressHandler);
      progressHandler = null;
    }
    if (v === 'kinetic' && !prefersReducedMotion()) {
      bar.hidden = false;
      let raf = 0;
      const compute = () => {
        raf = 0;
        const h = document.documentElement;
        const max = h.scrollHeight - h.clientHeight;
        const p = max > 0 ? h.scrollTop / max : 0;
        bar.style.transform = 'scaleX(' + p.toFixed(4) + ')';
      };
      progressHandler = () => { if (!raf) raf = requestAnimationFrame(compute); };
      window.addEventListener('scroll', progressHandler, { passive: true });
      window.addEventListener('resize', progressHandler);
      compute();
    } else {
      bar.hidden = true;
    }
  }

  function applyVariant(v, opts) {
    const root = document.documentElement;
    if (v === 'parchment') root.removeAttribute('data-variant');
    else root.setAttribute('data-variant', v);

    document.querySelectorAll('[data-variant-set]').forEach((b) => {
      b.setAttribute('aria-pressed', String(b.dataset.variantSet === v));
    });

    // Canvas figures cache their palette at init; tell them to re-read it.
    window.dispatchEvent(new Event('variantchange'));

    setupKinetic(v);
    if (opts && opts.fromClick && v === 'kinetic') runHeaderEntrance();
  }

  function wire() {
    const sw = document.querySelector('[data-variant-switch]');
    if (!sw) return;

    sw.querySelectorAll('[data-variant-set]').forEach((b) => {
      b.addEventListener('click', () => {
        const v = b.dataset.variantSet;
        try { localStorage.setItem(KEY, v); } catch (e) { /* private mode */ }
        applyVariant(v, { fromClick: true });
      });
    });

    let saved = 'parchment';
    try { saved = localStorage.getItem(KEY) || 'parchment'; } catch (e) { /* ignore */ }
    if (!VARIANTS.includes(saved)) saved = 'parchment';
    applyVariant(saved, { fromClick: false });

    // This component owns the page's one-shot figure reveals.
    attachReveals(document);
  }

  wire();
  document.addEventListener('astro:after-swap', wire);
</script>
