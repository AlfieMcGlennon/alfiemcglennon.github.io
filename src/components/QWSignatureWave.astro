---
// Signature hero figure for "Reading a Quantum Weather Model".
// One complex signal on the left equals a stack of three simple waves on the
// right: the visual thesis of the post (a circuit's output is a truncated
// Fourier series). Static, native SVG, built on the site's parchment palette.
// Geometry is generated at build time so the curves are exact.
const c = {
  ink: '#1c1917', inkMuted: '#78716c', inkFaint: '#a8a29e',
  rule: '#ddd8d0', accent: '#4338ca', teal: '#0f766e', tealSoft: '#5b9b95',
};

const TAU = Math.PI * 2;
function wave(x0, x1, yb, amp, fn, K = 160) {
  let d = '';
  for (let i = 0; i <= K; i++) {
    const t = i / K;
    const x = x0 + (x1 - x0) * t;
    const y = yb - amp * fn(t);
    d += (i ? 'L' : 'M') + x.toFixed(2) + ' ' + y.toFixed(2) + ' ';
  }
  return d.trim();
}
const comp = (t) => 0.60 * Math.sin(TAU * t) + 0.30 * Math.sin(2 * TAU * t + 0.6) + 0.20 * Math.sin(3 * TAU * t + 1.3);
const f1 = (t) => Math.sin(TAU * t);
const f2 = (t) => Math.sin(2 * TAU * t + 0.6);
const f3 = (t) => Math.sin(3 * TAU * t + 1.3);

const dComp = wave(28, 296, 96, 46, comp);
const dF1 = wave(384, 652, 58, 15, f1);
const dF2 = wave(384, 652, 103, 15, f2);
const dF3 = wave(384, 652, 148, 15, f3);
---

<figure class="qw-fig" data-reveal>
  <svg viewBox="0 0 680 200" role="img" aria-label="A single complex signal on the left equals the sum of three simple waves of different frequencies on the right.">
    <!-- left: one complex signal -->
    <line x1="28" y1="96" x2="296" y2="96" stroke={c.rule} stroke-width="1" stroke-dasharray="2 4" />
    <path d={dComp} fill="none" stroke={c.accent} stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
    <text x="162" y="186" text-anchor="middle" font-family="'JetBrains Mono', monospace" font-size="12" fill={c.inkMuted} letter-spacing="0.5">one signal</text>

    <!-- equals -->
    <text x="334" y="105" text-anchor="middle" font-family="'JetBrains Mono', monospace" font-size="27" fill={c.ink}>=</text>

    <!-- right: a sum of simple waves -->
    <line x1="384" y1="58" x2="652" y2="58" stroke={c.rule} stroke-width="1" stroke-dasharray="2 4" />
    <line x1="384" y1="103" x2="652" y2="103" stroke={c.rule} stroke-width="1" stroke-dasharray="2 4" />
    <line x1="384" y1="148" x2="652" y2="148" stroke={c.rule} stroke-width="1" stroke-dasharray="2 4" />
    <path d={dF1} fill="none" stroke={c.accent} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    <path d={dF2} fill="none" stroke={c.teal} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    <path d={dF3} fill="none" stroke={c.tealSoft} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    <text x="368" y="84" text-anchor="middle" font-family="'JetBrains Mono', monospace" font-size="19" fill={c.inkFaint}>+</text>
    <text x="368" y="129" text-anchor="middle" font-family="'JetBrains Mono', monospace" font-size="19" fill={c.inkFaint}>+</text>
    <text x="518" y="186" text-anchor="middle" font-family="'JetBrains Mono', monospace" font-size="12" fill={c.inkMuted} letter-spacing="0.5">a sum of simple waves</text>
  </svg>
  <figcaption>Whatever a circuit like this computes is a stack of simple waves.</figcaption>
</figure>

<style>
  .qw-fig {
    margin: 2.25rem 0 1.25rem;
  }
  .qw-fig svg {
    width: 100%;
    height: auto;
    display: block;
    background: var(--bg-raised, #f7f6f2);
    border: 1px solid var(--rule, #ddd8d0);
    border-radius: 6px;
    padding: 0.4rem 0.6rem;
  }
  .qw-fig figcaption {
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.72rem;
    line-height: 1.5;
    color: var(--ink-muted, #78716c);
    text-align: center;
    margin-top: 0.7rem;
    letter-spacing: 0.01em;
  }
</style>
