---
// HeroPhysical.astro — Hero Lab variant 4: the sky as a computed model of
// Reading right now. Same architecture as HeroAtmosphere (a CSS-gradient sky
// behind a single canvas, driven by @property-registered custom properties
// with a reduced-motion-gated transition, plus an atmosphere-style bottom
// telemetry readout) but the gradient itself is derived continuously from
// the sun's true solar elevation (src/scripts/solar.js) rather than a static
// per-condition table, and the canvas draws the sun/moon at their ACTUAL
// azimuth/elevation over Reading (51.4543, -0.9781), drawn cumulus/stratus
// clouds with parallax, precipitation, and an abstract downland horizon —
// see src/scripts/hero-lab-physical.js for the renderer.
---

<section
  class="lab-hero lab-hero-physical"
  data-hero-variant="physical"
  data-lab-panel="physical"
  hidden
  aria-label="Physical hero variant"
>
  <div class="phy-sky" aria-hidden="true"></div>
  <canvas class="phy-canvas" data-physical-canvas aria-hidden="true"></canvas>

  <div class="lab-hero-content">
    <h2 class="lab-hero-name">Alfie McGlennon</h2>
    <p class="lab-hero-affiliation">MSc Climate Change &amp; AI // University of Reading</p>
    <p class="lab-hero-tag">
      Climate science, machine learning, quantum, and compound risk.
      From copula-based dependence modelling to reinforcement learning on
      the national grid.
    </p>
    <p class="lab-hero-cta">
      <a href="/research/">Research</a>
      <a href="/projects/">Projects</a>
      <a href="/writing/">Writing</a>
    </p>
  </div>

  <div class="phy-readout" data-wx-panel aria-label="Live weather telemetry">
    <span class="pr-dot" aria-hidden="true"></span>
    <span class="pr-label" data-wx-status>STATIC</span>
    <span class="pr-sep" aria-hidden="true">&middot;</span>
    <span class="pr-loc">READING</span>
    <span class="pr-sep" aria-hidden="true">&middot;</span>
    <span class="pr-seg" data-wx-cond>&hellip;</span>
    <span class="pr-sep" aria-hidden="true">&middot;</span>
    <span class="pr-seg" data-wx-temp>--.-&deg;C</span>
    <span class="pr-seg pr-soft">feels <span data-wx-feels>--.-&deg;C</span></span>
    <span class="pr-seg pr-soft pr-hide-sm">dew <span data-wx-dew>--.-&deg;C</span></span>
    <span class="pr-seg pr-soft pr-hide-sm">wind <span data-wx-wind>-- KM/H --</span></span>
    <span class="pr-seg pr-soft pr-hide-sm">MSLP <span data-wx-pressure>---- HPA</span></span>
    <span class="pr-sep pr-hide-sm" aria-hidden="true">&middot;</span>
    <span class="pr-seg pr-time pr-hide-sm" data-wx-time>UPDATED --:--</span>
    <span class="pr-sep pr-hide-sm" aria-hidden="true">&middot;</span>
    <a class="pr-link pr-hide-sm" href="https://open-meteo.com" target="_blank" rel="noopener noreferrer">OPEN-METEO</a>
  </div>
</section>

<script>
  import { paintTelemetry } from '../scripts/weather.js';
  import { subscribe } from '../scripts/hero-lab-state.js';
  import { initPhysical } from '../scripts/hero-lab-physical.js';

  function boot() {
    const root = document.querySelector('[data-hero-variant="physical"]');
    if (!root) return;
    const renderer = initPhysical(root);
    // Re-runs on the live fetch AND on every lab-only override — see
    // src/scripts/hero-lab-state.js.
    subscribe((reading) => {
      if (!reading) return;
      paintTelemetry(root, reading);
      if (renderer) renderer.setData(reading);
    });
  }

  boot();
</script>

<style>
  .lab-hero-physical {
    position: relative;
    width: 100%;
    height: clamp(380px, 60vh, 560px);
    overflow: hidden;
    border-bottom: 1px solid var(--rule);

    --phy-top: #9ec4dc;
    --phy-mid: #e8cf9c;
    --phy-bot: #f0d4a0;
  }

  /* Registered as <color> so the gradient MORPHS between solar/condition
     states instead of snapping — mirrors HeroAtmosphere exactly. Harmless
     no-op where @property is unsupported. */
  @property --phy-top { syntax: '<color>'; inherits: true; initial-value: #9ec4dc; }
  @property --phy-mid { syntax: '<color>'; inherits: true; initial-value: #e8cf9c; }
  @property --phy-bot { syntax: '<color>'; inherits: true; initial-value: #f0d4a0; }

  @media (prefers-reduced-motion: no-preference) {
    .lab-hero-physical {
      transition:
        --phy-top 1.1s ease-in-out,
        --phy-mid 1.1s ease-in-out,
        --phy-bot 1.1s ease-in-out;
    }
  }

  .phy-sky {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(180deg, var(--phy-top) 0%, var(--phy-mid) 55%, var(--phy-bot) 100%);
    transition: background 0.8s ease;
  }

  .phy-canvas {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    display: block;
  }

  .lab-hero-content {
    position: relative;
    z-index: 2;
    max-width: 920px;
    margin: 0 auto;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0 1.5rem;
  }

  .lab-hero-name {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: clamp(2.4rem, 6.5vw, 4rem);
    line-height: 1.05;
    letter-spacing: -0.022em;
    color: var(--ink);
    margin-bottom: 0.85rem;
    text-shadow: 0 1px 2px rgba(255, 255, 255, 0.3);
  }

  .lab-hero-affiliation {
    font-family: var(--font-mono);
    font-size: clamp(0.85rem, 1.4vw, 1rem);
    color: var(--teal-deep);
    margin-bottom: 0.85rem;
    letter-spacing: 0.01em;
  }

  .lab-hero-tag {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1rem, 1.7vw, 1.2rem);
    color: var(--ink-dim);
    max-width: 42ch;
    line-height: 1.45;
    margin-bottom: 1.1rem;
  }

  .lab-hero-cta {
    display: flex;
    gap: 1.4rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .lab-hero-cta a {
    color: var(--teal-deep);
    border-bottom: 1px dotted var(--teal);
    padding-bottom: 2px;
  }

  .lab-hero-cta a:hover {
    color: var(--teal);
    border-bottom-color: var(--teal);
  }

  /* Night / storm skies invert text contrast, mirroring the live homepage
     hero and HeroAtmosphere. */
  .lab-hero-physical[data-day-night="night"] .lab-hero-name,
  .lab-hero-physical[data-condition="thunderstorm"] .lab-hero-name {
    color: #f3efe9;
    text-shadow: none;
  }
  .lab-hero-physical[data-day-night="night"] .lab-hero-affiliation,
  .lab-hero-physical[data-condition="thunderstorm"] .lab-hero-affiliation {
    color: #9bd0c8;
  }
  .lab-hero-physical[data-day-night="night"] .lab-hero-tag,
  .lab-hero-physical[data-condition="thunderstorm"] .lab-hero-tag {
    color: #d6d1c4;
  }

  .phy-readout {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.55rem;
    padding: 0.65rem 1rem 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-dim);
    text-shadow: 0 1px 1px rgba(255, 255, 255, 0.4), 0 0 6px rgba(255, 255, 255, 0.18);
  }

  .lab-hero-physical[data-day-night="night"] .phy-readout,
  .lab-hero-physical[data-condition="thunderstorm"] .phy-readout {
    color: #ece8de;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.45), 0 0 6px rgba(0, 0, 0, 0.25);
  }

  .pr-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--teal);
    display: inline-block;
  }

  .wx-live .pr-dot {
    animation: pr-pulse 2s ease-in-out infinite;
  }

  @keyframes pr-pulse {
    0%, 100% { opacity: 0.5; transform: scale(0.85); }
    50% { opacity: 1; transform: scale(1.18); }
  }

  .pr-label,
  .pr-loc {
    color: var(--teal-deep);
    font-weight: 600;
  }

  .lab-hero-physical[data-day-night="night"] .pr-label,
  .lab-hero-physical[data-day-night="night"] .pr-loc,
  .lab-hero-physical[data-condition="thunderstorm"] .pr-label,
  .lab-hero-physical[data-condition="thunderstorm"] .pr-loc {
    color: #7fd3c4;
  }

  .wx-override .pr-label {
    color: var(--amber);
  }

  .pr-sep {
    color: var(--ink-faint);
    opacity: 0.6;
  }

  .pr-soft {
    color: var(--ink-muted);
  }

  .pr-link {
    color: var(--teal-deep);
    border-bottom: 1px dotted var(--teal);
    padding-bottom: 1px;
  }

  @media (max-width: 760px) {
    .phy-readout { font-size: 0.66rem; gap: 0.4rem; }
    .pr-hide-sm { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pr-dot { animation: none; opacity: 0.85; }
  }
</style>
