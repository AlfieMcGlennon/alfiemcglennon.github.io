---
// ReadingModes.astro — the post's reading-mode switcher (grand intro only).
// Two LIGHT modes (no dark; dark reads "too AI"):
//   Parchment : clean reading flow, quick-checks present but quiet (default)
//   Study     : the new learning stylisation — promotes the quick-check cards,
//               shows per-section recaps + "Idea n of 3" step counters, warmer
//               higher-contrast paper, resource shelf collapsed. Grounded in the
//               testing effect (Roediger/Karpicke), segmenting/signalling (Mayer)
//               and the quantum.country mnemonic medium.
// It only sets data-variant on <html>, persists the choice and dispatches
// 'variantchange'; GrandLayout owns the actual variant styling. Degrades to
// Parchment with no JS; reduced-motion safe (no transitions of its own).
---

<div class="rmodes" role="group" aria-label="Reading mode" data-reading-modes>
  <span class="rmodes-label">Read as</span>
  <button type="button" data-mode="parchment" aria-pressed="true">Parchment</button>
  <button type="button" data-mode="study" aria-pressed="false">Study</button>
  <span class="rmodes-note">Study adds recall prompts &amp; recaps</span>
</div>

<style is:global>
  .rmodes {
    display: flex; align-items: center; gap: 0.4rem; flex-wrap: wrap;
    width: fit-content; max-width: 100%;
    margin: 0 0 2.5rem; padding: 0.4rem 0.55rem;
    border: 1px solid var(--rule); border-radius: 999px; background: var(--bg-raised);
  }
  .rmodes-label { font-family: var(--font-mono); font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.14em; color: var(--ink-faint); padding: 0 0.35rem; }
  .rmodes button {
    font-family: var(--font-mono); font-size: 0.78rem; cursor: pointer;
    background: none; color: var(--ink-muted);
    border: 1px solid transparent; border-radius: 999px; padding: 0.28rem 0.85rem;
    transition: color 0.18s ease, background 0.18s ease, border-color 0.18s ease;
  }
  .rmodes button:hover { color: var(--ink); }
  .rmodes button[aria-pressed="true"] { color: var(--accent); border-color: var(--accent); background: color-mix(in srgb, var(--accent) 12%, transparent); }
  .rmodes-note { font-family: var(--font-mono); font-size: 0.68rem; color: var(--ink-faint); padding-left: 0.2rem; }
  @media (max-width: 560px) { .rmodes-note { display: none; } }
</style>

<script>
  const MODES = ['parchment', 'study'];
  const KEY = 'grand-reading-mode';

  function apply(mode) {
    const root = document.documentElement;
    if (mode === 'parchment') root.removeAttribute('data-variant');
    else root.setAttribute('data-variant', mode);
    document.querySelectorAll('[data-reading-modes] [data-mode]').forEach((b) => {
      b.setAttribute('aria-pressed', String(b.dataset.mode === mode));
    });
    window.dispatchEvent(new Event('variantchange')); // canvases re-read the (warmer) paper
  }

  function wire() {
    const root = document.querySelector('[data-reading-modes]');
    if (!root) return;
    root.querySelectorAll('[data-mode]').forEach((b) => {
      b.addEventListener('click', () => {
        const m = b.dataset.mode;
        try { localStorage.setItem(KEY, m); } catch (e) { /* private mode */ }
        apply(m);
      });
    });
    let saved = 'parchment';
    try { saved = localStorage.getItem(KEY) || 'parchment'; } catch (e) { /* ignore */ }
    if (!MODES.includes(saved)) saved = 'parchment';
    apply(saved);
  }

  wire();
  document.addEventListener('astro:after-swap', wire);
</script>
