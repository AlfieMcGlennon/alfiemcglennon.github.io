---
const pathname = Astro.url.pathname;

const links = [
  { href: '/tide/', label: 'Tide' },
  { href: '/archive/', label: 'Archive' },
];

// Pages kept under Archive rather than in the nav.
const archived = ['/research/', '/projects/', '/writing/', '/cv/'];

function isActive(href, current) {
  if (href === '/archive/' && archived.some(a => current.startsWith(a))) return true;
  return current === href || current.startsWith(href);
}
---

<nav class="nav">
  <div class="nav-inner">
    <a href="/" class="nav-brand">Alfie McGlennon</a>
    <ul class="nav-links">
      {links.map(link => (
        <li>
          <a href={link.href} class={isActive(link.href, pathname) ? 'active' : ''}>
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>
