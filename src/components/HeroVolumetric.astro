---
// HeroVolumetric.astro — Hero Lab variant 4: a physically-lit volumetric sky,
// the "wow ceiling" candidate. A single full-band WebGL quad renders a
// simplified single-scatter Rayleigh + Mie sky (real sun/moon position from
// src/scripts/solar.js), two lit fbm cloud layers driven by live cloud cover
// and wind, in-shader rain/snow, and hash-based night stars — all reacting
// live to src/scripts/hero-lab-state.js without a reload. three.js is loaded
// via a dynamic import() so the ~150KB cost only lands on pages that mount
// this component. If WebGL is unavailable or setup fails for any reason, the
// canvas is removed and a CSS-gradient fallback (.vol-sky, same idea as
// HeroAtmosphere's .atm-sky) takes over — telemetry keeps working either way.
---

<section
  class="lab-hero lab-hero-volumetric"
  data-hero-variant="volumetric"
  data-lab-panel="volumetric"
  hidden
  aria-label="Volumetric hero variant"
>
  <div class="vol-sky" aria-hidden="true"></div>
  <canvas class="vol-canvas" data-volumetric-canvas aria-hidden="true"></canvas>

  <div class="lab-hero-content">
    <h2 class="lab-hero-name">Alfie McGlennon</h2>
    <p class="lab-hero-affiliation">MSc Climate Change &amp; AI // University of Reading</p>
    <p class="lab-hero-tag">
      Climate science, machine learning, quantum, and compound risk.
      From copula-based dependence modelling to reinforcement learning on
      the national grid.
    </p>
    <p class="lab-hero-cta">
      <a href="/research/">Research</a>
      <a href="/projects/">Projects</a>
      <a href="/writing/">Writing</a>
    </p>
  </div>

  <div class="vol-readout" data-wx-panel aria-label="Live weather telemetry">
    <span class="vr-dot" aria-hidden="true"></span>
    <span class="vr-label" data-wx-status>STATIC</span>
    <span class="vr-sep" aria-hidden="true">&middot;</span>
    <span class="vr-loc">READING</span>
    <span class="vr-sep" aria-hidden="true">&middot;</span>
    <span class="vr-seg" data-wx-cond>&hellip;</span>
    <span class="vr-sep" aria-hidden="true">&middot;</span>
    <span class="vr-seg" data-wx-temp>--.-&deg;C</span>
    <span class="vr-seg vr-soft">feels <span data-wx-feels>--.-&deg;C</span></span>
    <span class="vr-seg vr-soft vr-hide-sm">dew <span data-wx-dew>--.-&deg;C</span></span>
    <span class="vr-seg vr-soft vr-hide-sm">wind <span data-wx-wind>-- KM/H --</span></span>
    <span class="vr-seg vr-soft vr-hide-sm">MSLP <span data-wx-pressure>---- HPA</span></span>
    <span class="vr-sep vr-hide-sm" aria-hidden="true">&middot;</span>
    <span class="vr-seg vr-time vr-hide-sm" data-wx-time>UPDATED --:--</span>
    <span class="vr-sep vr-hide-sm" aria-hidden="true">&middot;</span>
    <a class="vr-link vr-hide-sm" href="https://open-meteo.com" target="_blank" rel="noopener noreferrer">OPEN-METEO</a>
  </div>
</section>

<script>
  import { paintTelemetry } from '../scripts/weather.js';
  import { subscribe } from '../scripts/hero-lab-state.js';
  import { initVolumetric } from '../scripts/hero-lab-volumetric.js';

  function boot() {
    const root = document.querySelector('[data-hero-variant="volumetric"]');
    if (!root) return;

    // The WebGL setup is async (three.js is dynamically imported), but
    // telemetry + the CSS fallback gradient must never wait on it — paint
    // immediately on every reading and replay the latest one into the
    // renderer once it's ready.
    let renderer = null;
    let pending = null;

    subscribe((reading) => {
      if (!reading) return;
      paintTelemetry(root, reading);
      if (renderer) renderer.setData(reading);
      else pending = reading;
    });

    initVolumetric(root).then((r) => {
      renderer = r;
      if (renderer && pending) renderer.setData(pending);
    });
  }

  boot();
</script>

<style>
  .lab-hero-volumetric {
    position: relative;
    width: 100%;
    height: clamp(380px, 60vh, 560px);
    overflow: hidden;
    border-bottom: 1px solid var(--rule);

    /* CSS fallback palette (only visible when WebGL is absent/fails) */
    --vol-top: #6f93b8;
    --vol-mid: #e8d4a8;
    --vol-bot: #ecb37a;
  }

  @property --vol-top { syntax: '<color>'; inherits: true; initial-value: #6f93b8; }
  @property --vol-mid { syntax: '<color>'; inherits: true; initial-value: #e8d4a8; }
  @property --vol-bot { syntax: '<color>'; inherits: true; initial-value: #ecb37a; }

  @media (prefers-reduced-motion: no-preference) {
    .lab-hero-volumetric {
      transition:
        --vol-top 1.1s ease-in-out,
        --vol-mid 1.1s ease-in-out,
        --vol-bot 1.1s ease-in-out;
    }
  }

  .vol-sky {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(180deg, var(--vol-top) 0%, var(--vol-mid) 55%, var(--vol-bot) 100%);
    transition: background 0.8s ease;
  }

  .vol-canvas {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    display: block;
  }

  /* When the WebGL init fails, the script strips this attribute's value to
     "fallback" (the canvas itself is also removed from the DOM — belt and
     braces) so nothing here depends on JS staying alive to look right. */
  .lab-hero-volumetric[data-webgl="fallback"] .vol-canvas {
    display: none;
  }

  .lab-hero-content {
    position: relative;
    z-index: 2;
    max-width: 920px;
    margin: 0 auto;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0 1.5rem;
  }

  .lab-hero-name {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: clamp(2.4rem, 6.5vw, 4rem);
    line-height: 1.05;
    letter-spacing: -0.022em;
    color: var(--ink);
    margin-bottom: 0.85rem;
    text-shadow: 0 1px 2px rgba(255, 255, 255, 0.3);
  }

  .lab-hero-affiliation {
    font-family: var(--font-mono);
    font-size: clamp(0.85rem, 1.4vw, 1rem);
    color: var(--teal-deep);
    margin-bottom: 0.85rem;
    letter-spacing: 0.01em;
  }

  .lab-hero-tag {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1rem, 1.7vw, 1.2rem);
    color: var(--ink-dim);
    max-width: 42ch;
    line-height: 1.45;
    margin-bottom: 1.1rem;
  }

  .lab-hero-cta {
    display: flex;
    gap: 1.4rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .lab-hero-cta a {
    color: var(--teal-deep);
    border-bottom: 1px dotted var(--teal);
    padding-bottom: 2px;
  }

  .lab-hero-cta a:hover {
    color: var(--teal);
    border-bottom-color: var(--teal);
  }

  /* Night / storm skies invert text contrast, mirroring the live homepage hero
     and the Atmosphere variant. */
  .lab-hero-volumetric[data-day-night="night"] .lab-hero-name,
  .lab-hero-volumetric[data-condition="thunderstorm"] .lab-hero-name {
    color: #f3efe9;
    text-shadow: none;
  }
  .lab-hero-volumetric[data-day-night="night"] .lab-hero-affiliation,
  .lab-hero-volumetric[data-condition="thunderstorm"] .lab-hero-affiliation {
    color: #9bd0c8;
  }
  .lab-hero-volumetric[data-day-night="night"] .lab-hero-tag,
  .lab-hero-volumetric[data-condition="thunderstorm"] .lab-hero-tag {
    color: #d6d1c4;
  }

  .vol-readout {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.55rem;
    padding: 0.65rem 1rem 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-dim);
    text-shadow: 0 1px 1px rgba(255, 255, 255, 0.4), 0 0 6px rgba(255, 255, 255, 0.18);
  }

  .lab-hero-volumetric[data-day-night="night"] .vol-readout,
  .lab-hero-volumetric[data-condition="thunderstorm"] .vol-readout {
    color: #ece8de;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.45), 0 0 6px rgba(0, 0, 0, 0.25);
  }

  .vr-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--teal);
    display: inline-block;
  }

  .wx-live .vr-dot {
    animation: vr-pulse 2s ease-in-out infinite;
  }

  @keyframes vr-pulse {
    0%, 100% { opacity: 0.5; transform: scale(0.85); }
    50% { opacity: 1; transform: scale(1.18); }
  }

  .vr-label,
  .vr-loc {
    color: var(--teal-deep);
    font-weight: 600;
  }

  .lab-hero-volumetric[data-day-night="night"] .vr-label,
  .lab-hero-volumetric[data-day-night="night"] .vr-loc,
  .lab-hero-volumetric[data-condition="thunderstorm"] .vr-label,
  .lab-hero-volumetric[data-condition="thunderstorm"] .vr-loc {
    color: #7fd3c4;
  }

  .wx-override .vr-label {
    color: var(--amber);
  }

  .vr-sep {
    color: var(--ink-faint);
    opacity: 0.6;
  }

  .vr-soft {
    color: var(--ink-muted);
  }

  .vr-link {
    color: var(--teal-deep);
    border-bottom: 1px dotted var(--teal);
    padding-bottom: 1px;
  }

  @media (max-width: 760px) {
    .vol-readout { font-size: 0.66rem; gap: 0.4rem; }
    .vr-hide-sm { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .vr-dot { animation: none; opacity: 0.85; }
  }
</style>
