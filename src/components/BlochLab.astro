---
// BlochLab.astro — the "showcase" qubit interactive: a shaded, glowing, slowly
// orbiting 3D Bloch sphere with a cinematic measurement collapse and an animated
// Monte-Carlo of 100 looks (shots rain into bins, with a live convergence
// sparkline). Honest: the arrow never evolves on its own (only the *camera*
// idles, i.e. you orbit a static object); phase phi is shown not to change the
// odds; "Look" collapses to a pole and the tilt is destroyed.
//
// Mirrors QubitArrow's API so it can be swapped in for it:
//   <BlochLab />          -> section 3 (tilt -> odds, + phase)
//   <BlochLab measure />  -> section 4 (collapse + Monte-Carlo)
// Scoped per-root (used twice on the page); reduced-motion gives static figures
// and synchronous results with nothing lost.
const { measure = false } = Astro.props;
---

<div class="blab" data-bloch-lab data-reveal data-measure={measure ? '1' : '0'}>
  <div class="blab-grid">
    <div class="blab-stage">
      <canvas class="blab-canvas" role="img"
        aria-label="A glowing 3D Bloch sphere with an arrow you can tilt between 0 at the top and 1 at the bottom, and orbit by dragging."></canvas>
      <p class="blab-hint">drag to orbit &middot; slide to tilt</p>
    </div>

    <div class="blab-side">
      <label class="blab-ctl">
        <span class="blab-ctl-top">Tilt <span class="blab-sym">&theta;</span><output class="blab-theta-v"></output></span>
        <input class="blab-theta" type="range" min="0" max="180" value="58" step="1" />
      </label>
      <label class="blab-ctl">
        <span class="blab-ctl-top">Phase <span class="blab-sym">&phi;</span><output class="blab-phi-v"></output></span>
        <input class="blab-phi" type="range" min="0" max="360" value="40" step="1" />
        <span class="blab-note">spins the arrow sideways, and the odds do not change</span>
      </label>

      <div class="blab-odds">
        <div class="blab-bar-row"><span class="blab-k">0</span><div class="blab-bar"><i class="blab-bar0"></i></div><span class="blab-p0"></span></div>
        <div class="blab-bar-row"><span class="blab-k">1</span><div class="blab-bar"><i class="blab-bar1"></i></div><span class="blab-p1"></span></div>
      </div>

      {measure && (
        <div class="blab-measure">
          <div class="blab-btns">
            <button type="button" class="blab-once">Look once</button>
            <button type="button" class="blab-many">Look 100&times;</button>
          </div>
          <canvas class="blab-spark" role="img"
            aria-label="A sparkline of the running estimate of the odds converging toward the true value as looks accumulate."></canvas>
          <p class="blab-result" aria-live="polite"></p>
        </div>
      )}
    </div>
  </div>
</div>

<style>
  /* Token-driven: warm/light on the parchment site, dark+glowing on the showcase
     (where body.showcase flips --bg-raised/--ink/--accent and sets --lab-glow). */
  .blab {
    margin: 2rem 0;
    padding: 1rem;
    border: 1px solid var(--rule);
    border-radius: 12px;
    background:
      radial-gradient(120% 80% at 15% 0%, color-mix(in srgb, var(--accent) 7%, transparent), transparent 60%),
      var(--bg-raised);
    box-shadow: 0 10px 30px -24px rgba(0, 0, 0, 0.32);
  }
  .blab-grid { display: grid; grid-template-columns: 1.05fr 1fr; gap: 1.25rem; align-items: center; }
  .blab-stage { display: flex; flex-direction: column; gap: 0.4rem; }
  .blab-canvas {
    width: 100%; aspect-ratio: 1; display: block;
    border: 1px solid var(--rule); border-radius: 10px;
    background: var(--bg-raised);
    cursor: grab; touch-action: none;
  }
  .blab-canvas:active { cursor: grabbing; }
  .blab-hint { margin: 0; text-align: center; font-family: var(--font-mono); font-size: 0.7rem; color: var(--ink-faint); letter-spacing: 0.02em; }

  .blab-side { display: flex; flex-direction: column; gap: 0.9rem; }
  .blab-ctl { display: flex; flex-direction: column; gap: 0.35rem; }
  .blab-ctl-top { display: flex; align-items: baseline; gap: 0.5rem; font-family: var(--font-mono); font-size: 0.78rem; color: var(--ink-muted); }
  .blab-sym { color: var(--accent); font-weight: 600; }
  .blab-ctl-top output { margin-left: auto; color: var(--accent); }
  .blab-note { font-family: var(--font-mono); font-size: 0.68rem; color: var(--ink-faint); }
  .blab input[type="range"] { width: 100%; accent-color: var(--accent); }

  .blab-odds { display: flex; flex-direction: column; gap: 0.4rem; }
  .blab-bar-row { display: grid; grid-template-columns: 1rem 1fr auto; align-items: center; gap: 0.5rem; font-family: var(--font-mono); font-size: 0.78rem; color: var(--ink-muted); }
  .blab-bar { height: 0.75rem; background: var(--rule-soft); border-radius: 4px; overflow: hidden; }
  .blab-bar i { display: block; height: 100%; width: 0; border-radius: 4px; }
  .blab-bar0 { background: var(--teal); }
  .blab-bar1 { background: var(--amber); }
  .blab-p0, .blab-p1 { color: var(--ink); min-width: 2.7rem; text-align: right; }

  .blab-measure { display: flex; flex-direction: column; gap: 0.6rem; border-top: 1px solid var(--rule); padding-top: 0.7rem; }
  .blab-btns { display: flex; gap: 0.5rem; }
  .blab-btns button {
    font-family: var(--font-mono); font-size: 0.78rem; cursor: pointer;
    color: var(--ink-dim); background: var(--bg);
    border: 1px solid var(--rule); border-radius: 7px; padding: 0.4rem 0.8rem;
    transition: color 0.18s ease, border-color 0.18s ease, background 0.18s ease, transform 0.05s ease;
  }
  .blab-btns button:hover { color: var(--accent); border-color: var(--accent); }
  .blab-btns button:active { transform: translateY(1px); }
  .blab-spark { width: 100%; height: 54px; display: block; border: 1px solid var(--rule); border-radius: 7px; background: var(--bg); }
  .blab-result { margin: 0; min-height: 1.1rem; font-family: var(--font-mono); font-size: 0.78rem; color: var(--accent); }

  @media (max-width: 640px) { .blab-grid { grid-template-columns: 1fr; } }
</style>

<script>
  import { StateVector } from '../scripts/qsim.js';
  import { animate } from 'animejs';
  import {
    labPalette, hexA, makeCamera, attachDrag, fitCanvas, prefersReducedMotion,
    lerp, easeOutCubic, clamp, rand, rafLoop, glowStroke, glowDot,
    drawLabSphere, drawLabArrow, projectBloch, scaleFor,
  } from '../scripts/labgfx.js';

  const PI = Math.PI;

  function initOne(root) {
    if (root._cleanup) root._cleanup();
    const measure = root.dataset.measure === '1';
    const reduced = prefersReducedMotion();

    const canvas = root.querySelector('.blab-canvas');
    const ctx = canvas.getContext('2d');
    const thetaIn = root.querySelector('.blab-theta');
    const phiIn = root.querySelector('.blab-phi');
    const thetaV = root.querySelector('.blab-theta-v');
    const phiV = root.querySelector('.blab-phi-v');
    const bar0 = root.querySelector('.blab-bar0');
    const bar1 = root.querySelector('.blab-bar1');
    const p0El = root.querySelector('.blab-p0');
    const p1El = root.querySelector('.blab-p1');

    const cam = makeCamera(-0.6, 0.42);
    const pal = labPalette();
    let dims = null;
    let busy = false;            // a collapse / monte-carlo is playing
    let inView = true;
    let lastInteract = 0;        // seconds; idle orbit resumes a beat after input
    let nowT = 0;
    let overlay = null;          // optional per-frame overlay (flash / sparks)
    let onResizeExtra = null;    // measure-only: re-fit the sparkline canvas
    let collapsed = null;        // a measured pole: persists (never springs back) until a fresh tilt
    let anim = null;             // current anime tween (collapse / monte-carlo), so re-init can stop it
    let onceBtn = null, manyBtn = null;

    const theta = () => +thetaIn.value;
    const phi = () => +phiIn.value;
    const p0 = () => Math.cos(theta() * PI / 360) ** 2; // cos^2(theta/2)
    function vecFrom(thDeg, phDeg) {
      const th = thDeg * PI / 180, ph = phDeg * PI / 180;
      return { x: Math.sin(th) * Math.cos(ph), y: Math.sin(th) * Math.sin(ph), z: Math.cos(th) };
    }
    // What to draw: a measured pole persists; otherwise the live tilt.
    const currentVec = () => collapsed || vecFrom(theta(), phi());

    function drawScene(v) {
      if (!dims) return;
      const { w, h } = dims;
      ctx.clearRect(0, 0, w, h);
      drawLabSphere(ctx, cam, w, h, pal);
      drawLabArrow(ctx, cam, w, h, v, pal);
      if (overlay) overlay(ctx, w, h);
    }

    function readout() {
      const a = p0(), b = 1 - a;
      const pc = (x) => Math.round(x * 100);
      thetaV.textContent = theta() + '°';
      phiV.textContent = phi() + '°';
      bar0.style.width = (a * 100).toFixed(0) + '%';
      bar1.style.width = (b * 100).toFixed(0) + '%';
      p0El.textContent = pc(a) + '%';
      p1El.textContent = pc(b) + '%';
      thetaIn.setAttribute('aria-valuetext',
        a > 0.85 ? 'near the top, almost always 0'
        : a < 0.15 ? 'near the bottom, almost always 1'
        : Math.abs(a - 0.5) < 0.12 ? 'sideways, roughly even odds'
        : a > 0.5 ? 'tilted up, more often 0' : 'tilted down, more often 1');
    }

    function render() { drawScene(vecFrom(theta(), phi())); readout(); }

    function resize() { dims = fitCanvas(canvas, ctx); render(); if (onResizeExtra) onResizeExtra(); }

    // ── idle camera orbit (you orbit a *static* object; honest + alive) ──
    const loop = rafLoop((dt, t) => {
      nowT = t;
      if (busy) return;
      if (!reduced && inView && (t - lastInteract) > 2.2) {
        cam.yaw += dt * 0.16;
        drawScene(currentVec());
      }
    });

    // A fresh tilt clears any measured pole and recomputes the odds.
    const onInput = () => { if (busy) return; collapsed = null; lastInteract = nowT; render(); };
    thetaIn.addEventListener('input', onInput);
    phiIn.addEventListener('input', onInput);
    // Dragging orbits the camera only: redraw the scene (preserving a collapsed
    // pole and the live bars), never reset the data.
    const detachDrag = attachDrag(canvas, cam, () => { if (busy) return; lastInteract = nowT; drawScene(currentVec()); });
    window.addEventListener('resize', resize);

    // Pause the loop when off-screen.
    let io = null;
    if (typeof IntersectionObserver !== 'undefined') {
      io = new IntersectionObserver((es) => {
        inView = es[0].isIntersecting;
        if (inView && !reduced) loop.start(); else loop.stop();
      }, { threshold: 0.05 });
      io.observe(root);
    }

    // ── measurement: collapse + Monte-Carlo ──
    let onOnce = null, onMany = null;
    if (measure) {
      const resultEl = root.querySelector('.blab-result');
      const spark = root.querySelector('.blab-spark');
      const sctx = spark.getContext('2d');
      let sdims = fitCanvas(spark, sctx);
      const sample = () => Math.random() < p0() ? 0 : 1;

      function drawSpark(series, truth) {
        const { w, h } = sdims;
        sctx.clearRect(0, 0, w, h);
        // truth line
        sctx.strokeStyle = hexA(pal.dim, 0.5);
        sctx.setLineDash([3, 3]); sctx.lineWidth = 1;
        const ty = (1 - truth) * h;
        sctx.beginPath(); sctx.moveTo(0, ty); sctx.lineTo(w, ty); sctx.stroke();
        sctx.setLineDash([]);
        if (series.length > 1) {
          glowStroke(sctx, pal.accentBright, 1.6, pal.glow, () => {
            for (let i = 0; i < series.length; i++) {
              const x = (i / (series.length - 1)) * w;
              const y = (1 - series[i]) * h;
              if (i === 0) sctx.moveTo(x, y); else sctx.lineTo(x, y);
            }
          });
        }
      }

      onOnce = () => {
        if (busy) return;
        busy = true;
        const out = sample();
        const startTh = theta();
        const poleTh = out === 0 ? 0 : 180;
        const finalV = { x: 0, y: 0, z: out === 0 ? 1 : -1 };
        const announce = 'You looked once and got: ' + out + '. The tilt is gone.';
        const colour = out === 0 ? pal.teal : pal.amber;

        if (reduced) { overlay = null; collapsed = finalV; drawScene(finalV); resultEl.textContent = announce; busy = false; return; }

        // sparks fly from the tip toward the chosen pole as it collapses
        const sparks = Array.from({ length: 22 }, () => ({ ang: rand(0, PI * 2), spd: rand(0.5, 1.3) }));
        const obj = { p: 0 };
        anim = animate(obj, {
          p: 1,
          duration: 640,
          ease: 'out(3)',
          onUpdate: () => {
            const e = easeOutCubic(obj.p);
            const th = lerp(startTh, poleTh, e);
            const ph = phi();
            overlay = (c, w, h) => {
              const s = scaleFor(w, h);
              const tip = projectBloch(vecFrom(th, ph), cam, w, h, s);
              const pole = projectBloch(finalV, cam, w, h, s);
              // spark burst
              for (const sp of sparks) {
                const r = s * 0.5 * sp.spd * (1 - obj.p);
                const x = lerp(tip.x, pole.x, e) + Math.cos(sp.ang) * r;
                const y = lerp(tip.y, pole.y, e) + Math.sin(sp.ang) * r;
                c.save(); c.globalAlpha = (1 - obj.p) * 0.9;
                glowDot(c, x, y, 1.8, colour, pal.glow); c.restore();
              }
              // flash ring at destination, second half
              if (obj.p > 0.45) {
                const fp = (obj.p - 0.45) / 0.55;
                c.save(); c.globalAlpha = (1 - fp) * 0.8;
                glowStroke(c, colour, 2, pal.glow, () => c.arc(pole.x, pole.y, s * 0.12 + fp * s * 0.5, 0, PI * 2));
                c.restore();
              }
            };
            drawScene(vecFrom(th, ph));
          },
          onComplete: () => { overlay = null; collapsed = finalV; drawScene(finalV); resultEl.textContent = announce; busy = false; lastInteract = nowT; },
        });
      };

      onMany = () => {
        if (busy) return;
        busy = true;
        collapsed = null;            // re-prepares a fresh tilt each shot
        const N = 100;
        const truth = p0();
        let c0 = 0, c1 = 0, done = 0;
        const series = [];
        const setBars = () => {
          const t = done || 1;
          bar0.style.width = (c0 / t * 100).toFixed(0) + '%';
          bar1.style.width = (c1 / t * 100).toFixed(0) + '%';
          p0El.textContent = Math.round(c0 / t * 100) + '%';
          p1El.textContent = Math.round(c1 / t * 100) + '%';
        };
        const step = () => { (Math.random() < truth ? (c0++) : (c1++)); done++; series.push(c0 / done); };
        const finishText = () => {
          resultEl.textContent = '100 looks: 0 came up ' + c0 + ', 1 came up ' + c1 +
            '. About ' + c0 + '% zeros, close to the tilt’s ' + Math.round(truth * 100) + '%.';
        };

        if (reduced) {
          for (let i = 0; i < N; i++) step();
          setBars(); drawSpark(series, truth); finishText(); busy = false; return;
        }

        const obj = { k: 0 };
        anim = animate(obj, {
          k: N,
          duration: 1600,
          ease: 'out(2)',
          onUpdate: () => {
            const target = Math.round(obj.k);
            while (done < target) step();
            setBars(); drawSpark(series, truth);
          },
          onComplete: () => { while (done < N) step(); setBars(); drawSpark(series, truth); finishText(); busy = false; },
        });
      };

      onceBtn = root.querySelector('.blab-once'); onceBtn.addEventListener('click', onOnce);
      manyBtn = root.querySelector('.blab-many'); manyBtn.addEventListener('click', onMany);

      onResizeExtra = () => { sdims = fitCanvas(spark, sctx); sctx.clearRect(0, 0, sdims.w, sdims.h); };
      drawSpark([], p0());
    }

    root._cleanup = () => {
      loop.stop();
      if (anim) { anim.pause(); anim = null; }
      detachDrag();
      if (io) io.disconnect();
      window.removeEventListener('resize', resize);
      thetaIn.removeEventListener('input', onInput);
      phiIn.removeEventListener('input', onInput);
      if (onceBtn && onOnce) onceBtn.removeEventListener('click', onOnce);
      if (manyBtn && onMany) manyBtn.removeEventListener('click', onMany);
      root._cleanup = null;
    };

    resize();
    if (!reduced) loop.start();
  }

  function initAll() { document.querySelectorAll('[data-bloch-lab]').forEach(initOne); }
  initAll();
  document.addEventListener('astro:after-swap', initAll);
  window.addEventListener('variantchange', initAll); // re-read palette on theme change
</script>
