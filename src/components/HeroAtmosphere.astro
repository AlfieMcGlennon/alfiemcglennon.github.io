---
// HeroAtmosphere.astro — Hero Lab variant 3: a layered sky band that
// reflects the ACTUAL current Reading sky. The gradient (top/mid/bottom +
// sun glow opacity) is set once per data update via CSS custom properties
// driven by is_day, cloud_cover and a dusk/dawn local-hour check; a thin
// canvas layer adds a handful of soft drifting cloud blobs and, only when
// it is actually precipitating, rain/snow streaks. The band sits within the
// hero (not a page takeover) and stays parchment-integrated at rest.
---

<section
  class="lab-hero lab-hero-atmosphere"
  data-hero-variant="atmosphere"
  data-lab-panel="atmosphere"
  hidden
  aria-label="Atmosphere hero variant"
>
  <div class="atm-sky" aria-hidden="true"></div>
  <div class="atm-sun" aria-hidden="true"></div>
  <canvas class="atm-canvas" data-atmosphere-canvas aria-hidden="true"></canvas>

  <div class="lab-hero-content">
    <h2 class="lab-hero-name">Alfie McGlennon</h2>
    <p class="lab-hero-affiliation">MSc Climate Change &amp; AI // University of Reading</p>
    <p class="lab-hero-tag">
      Climate science, machine learning, quantum, and compound risk.
      From copula-based dependence modelling to reinforcement learning on
      the national grid.
    </p>
    <p class="lab-hero-cta">
      <a href="/research/">Research</a>
      <a href="/projects/">Projects</a>
      <a href="/writing/">Writing</a>
    </p>
  </div>

  <div class="atm-readout" data-wx-panel aria-label="Live weather telemetry">
    <span class="ar-dot" aria-hidden="true"></span>
    <span class="ar-label" data-wx-status>STATIC</span>
    <span class="ar-sep" aria-hidden="true">&middot;</span>
    <span class="ar-loc">READING</span>
    <span class="ar-sep" aria-hidden="true">&middot;</span>
    <span class="ar-seg" data-wx-cond>&hellip;</span>
    <span class="ar-sep" aria-hidden="true">&middot;</span>
    <span class="ar-seg" data-wx-temp>--.-&deg;C</span>
    <span class="ar-seg ar-soft">feels <span data-wx-feels>--.-&deg;C</span></span>
    <span class="ar-seg ar-soft ar-hide-sm">dew <span data-wx-dew>--.-&deg;C</span></span>
    <span class="ar-seg ar-soft ar-hide-sm">wind <span data-wx-wind>-- KM/H --</span></span>
    <span class="ar-seg ar-soft ar-hide-sm">MSLP <span data-wx-pressure>---- HPA</span></span>
    <span class="ar-sep ar-hide-sm" aria-hidden="true">&middot;</span>
    <span class="ar-seg ar-time ar-hide-sm" data-wx-time>UPDATED --:--</span>
    <span class="ar-sep ar-hide-sm" aria-hidden="true">&middot;</span>
    <a class="ar-link ar-hide-sm" href="https://open-meteo.com" target="_blank" rel="noopener noreferrer">OPEN-METEO</a>
  </div>
</section>

<script>
  import { paintTelemetry } from '../scripts/weather.js';
  import { subscribe } from '../scripts/hero-lab-state.js';
  import { initAtmosphere } from '../scripts/hero-lab-atmosphere.js';

  function boot() {
    const root = document.querySelector('[data-hero-variant="atmosphere"]');
    if (!root) return;
    const renderer = initAtmosphere(root);
    // Re-runs on the live fetch AND on every lab-only override — see
    // src/scripts/hero-lab-state.js.
    subscribe((reading) => {
      if (!reading) return;
      paintTelemetry(root, reading);
      if (renderer) renderer.setData(reading);
    });
  }

  boot();
</script>

<style>
  .lab-hero-atmosphere {
    position: relative;
    width: 100%;
    height: clamp(380px, 60vh, 560px);
    overflow: hidden;
    border-bottom: 1px solid var(--rule);

    --atm-top: #b6cfdc;
    --atm-mid: #e8d4a8;
    --atm-bot: #ecb37a;
    --atm-sun: 0.85;
  }

  /* Registered as <color> so the gradient MORPHS between weather states
     instead of snapping (transition: background can't interpolate a
     gradient). Harmless no-op where @property is unsupported. */
  @property --atm-top { syntax: '<color>'; inherits: true; initial-value: #b6cfdc; }
  @property --atm-mid { syntax: '<color>'; inherits: true; initial-value: #e8d4a8; }
  @property --atm-bot { syntax: '<color>'; inherits: true; initial-value: #ecb37a; }

  @media (prefers-reduced-motion: no-preference) {
    .lab-hero-atmosphere {
      transition:
        --atm-top 1.1s ease-in-out,
        --atm-mid 1.1s ease-in-out,
        --atm-bot 1.1s ease-in-out;
    }
  }

  .atm-sky {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(180deg, var(--atm-top) 0%, var(--atm-mid) 55%, var(--atm-bot) 100%);
    transition: background 0.8s ease;
  }

  .atm-sun {
    position: absolute;
    top: 12%;
    right: 12%;
    z-index: 1;
    width: clamp(130px, 20vw, 220px);
    height: clamp(130px, 20vw, 220px);
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(255, 243, 216, 0.8) 0%,
      rgba(255, 219, 156, 0.35) 18%,
      rgba(255, 210, 145, 0.12) 42%,
      rgba(255, 210, 145, 0) 68%
    );
    opacity: var(--atm-sun);
    transition: opacity 0.8s ease;
    pointer-events: none;
  }

  .atm-canvas {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    display: block;
  }

  .lab-hero-content {
    position: relative;
    z-index: 2;
    max-width: 920px;
    margin: 0 auto;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0 1.5rem;
  }

  .lab-hero-name {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: clamp(2.4rem, 6.5vw, 4rem);
    line-height: 1.05;
    letter-spacing: -0.022em;
    color: var(--ink);
    margin-bottom: 0.85rem;
    text-shadow: 0 1px 2px rgba(255, 255, 255, 0.3);
  }

  .lab-hero-affiliation {
    font-family: var(--font-mono);
    font-size: clamp(0.85rem, 1.4vw, 1rem);
    color: var(--teal-deep);
    margin-bottom: 0.85rem;
    letter-spacing: 0.01em;
  }

  .lab-hero-tag {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1rem, 1.7vw, 1.2rem);
    color: var(--ink-dim);
    max-width: 42ch;
    line-height: 1.45;
    margin-bottom: 1.1rem;
  }

  .lab-hero-cta {
    display: flex;
    gap: 1.4rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .lab-hero-cta a {
    color: var(--teal-deep);
    border-bottom: 1px dotted var(--teal);
    padding-bottom: 2px;
  }

  .lab-hero-cta a:hover {
    color: var(--teal);
    border-bottom-color: var(--teal);
  }

  /* Night / storm skies invert text contrast, mirroring the live homepage hero. */
  .lab-hero-atmosphere[data-day-night="night"] .lab-hero-name,
  .lab-hero-atmosphere[data-condition="thunderstorm"] .lab-hero-name {
    color: #f3efe9;
    text-shadow: none;
  }
  .lab-hero-atmosphere[data-day-night="night"] .lab-hero-affiliation,
  .lab-hero-atmosphere[data-condition="thunderstorm"] .lab-hero-affiliation {
    color: #9bd0c8;
  }
  .lab-hero-atmosphere[data-day-night="night"] .lab-hero-tag,
  .lab-hero-atmosphere[data-condition="thunderstorm"] .lab-hero-tag {
    color: #d6d1c4;
  }

  .atm-readout {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.55rem;
    padding: 0.65rem 1rem 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-dim);
    text-shadow: 0 1px 1px rgba(255, 255, 255, 0.4), 0 0 6px rgba(255, 255, 255, 0.18);
  }

  .lab-hero-atmosphere[data-day-night="night"] .atm-readout,
  .lab-hero-atmosphere[data-condition="thunderstorm"] .atm-readout {
    color: #ece8de;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.45), 0 0 6px rgba(0, 0, 0, 0.25);
  }

  .ar-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--teal);
    display: inline-block;
  }

  .wx-live .ar-dot {
    animation: ar-pulse 2s ease-in-out infinite;
  }

  @keyframes ar-pulse {
    0%, 100% { opacity: 0.5; transform: scale(0.85); }
    50% { opacity: 1; transform: scale(1.18); }
  }

  .ar-label,
  .ar-loc {
    color: var(--teal-deep);
    font-weight: 600;
  }

  .lab-hero-atmosphere[data-day-night="night"] .ar-label,
  .lab-hero-atmosphere[data-day-night="night"] .ar-loc,
  .lab-hero-atmosphere[data-condition="thunderstorm"] .ar-label,
  .lab-hero-atmosphere[data-condition="thunderstorm"] .ar-loc {
    color: #7fd3c4;
  }

  .wx-override .ar-label {
    color: var(--amber);
  }

  .ar-sep {
    color: var(--ink-faint);
    opacity: 0.6;
  }

  .ar-soft {
    color: var(--ink-muted);
  }

  .ar-link {
    color: var(--teal-deep);
    border-bottom: 1px dotted var(--teal);
    padding-bottom: 1px;
  }

  @media (max-width: 760px) {
    .atm-readout { font-size: 0.66rem; gap: 0.4rem; }
    .ar-hide-sm { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ar-dot { animation: none; opacity: 0.85; }
  }
</style>
