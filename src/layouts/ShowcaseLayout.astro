---
// ShowcaseLayout.astro — a self-contained dark, polished layout for the
// "Lab" showcase of the quantum intro. It reuses global.css for base typography
// but flips every token dark on body.showcase, then layers a glassy hero, a
// reading-progress bar and scroll reveals. noindex (it previews a draft).
import '../styles/global.css';

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} · Showcase</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="showcase">
    <div class="sc-progress" data-sc-progress aria-hidden="true"></div>

    <div class="sc-topbar">
      <a href="/" class="sc-brand">Alfie McGlennon</a>
      <a href="/writing/what-is-quantum/" class="sc-plain">&larr; plain version</a>
    </div>

    <header class="sc-hero">
      <p class="sc-kicker">Interactive showcase</p>
      <h1 class="sc-title">{title}</h1>
      <p class="sc-lede">{description}</p>
    </header>

    <main class="sc-main">
      <article class="sc-article">
        <slot />
      </article>
    </main>

    <footer class="sc-foot">
      <a href="/writing/what-is-quantum/" class="sc-plain">&larr; back to the plain version</a>
    </footer>

    <style is:global>
      html { background: #07090f; }
      body.showcase {
        --bg: #07090f;
        --bg-raised: #0f1320;
        --rule: #222a3f;
        --rule-soft: #1a2030;
        --ink: #e7e9f0;
        --ink-dim: #c4c9d6;
        --ink-muted: #9aa3bd;
        --ink-faint: #5e6675;
        --teal: #34e7c9;
        --teal-deep: #5eead4;
        --teal-soft: #103b37;
        --amber: #fbbf24;
        --amber-soft: #4a3212;
        --accent: #8b93f8;
        --lab-panel: #0f1320;
        --lab-ink: #e7e9f0;
        --lab-dim: #9aa3bd;
        --lab-accent: #8b93f8;
        --lab-accent-bright: #c2c8ff;
        background:
          radial-gradient(80% 50% at 50% -10%, rgba(99, 110, 210, 0.16), transparent 60%),
          var(--bg);
      }
      /* Reveal start-state for the showcase figures + chrome. */
      @media (prefers-reduced-motion: no-preference) {
        html.reveal-armed [data-reveal] { opacity: 0; transform: translateY(16px); }
        html.reveal-armed [data-reveal].is-revealed { opacity: 1; transform: none; transition: opacity 0.6s ease, transform 0.6s ease; }
      }
    </style>

    <style>
      .sc-progress {
        position: fixed; top: 0; left: 0; right: 0; height: 3px;
        background: linear-gradient(90deg, var(--accent), #c2c8ff);
        transform: scaleX(0); transform-origin: left center;
        z-index: 60; pointer-events: none; box-shadow: 0 0 12px rgba(139, 147, 248, 0.6);
      }
      .sc-topbar {
        max-width: 940px; margin: 0 auto; padding: 1.3rem 1.5rem;
        display: flex; align-items: center; justify-content: space-between;
      }
      .sc-brand { font-family: var(--font-sans); font-weight: 700; font-size: 1.02rem; color: var(--ink); border-bottom: 0; letter-spacing: -0.01em; }
      .sc-plain { font-family: var(--font-mono); font-size: 0.8rem; color: var(--ink-muted); border-bottom: 0; }
      .sc-plain:hover { color: var(--accent); }

      .sc-hero { max-width: 820px; margin: 2.5rem auto 1rem; padding: 0 1.5rem; }
      .sc-kicker {
        font-family: var(--font-mono); font-size: 0.74rem; text-transform: uppercase;
        letter-spacing: 0.2em; color: var(--accent); margin-bottom: 1rem;
      }
      .sc-title {
        font-family: var(--font-sans); font-weight: 800;
        font-size: clamp(2.6rem, 7vw, 4.2rem); line-height: 1.02; letter-spacing: -0.04em;
        color: var(--ink); margin: 0 0 1.1rem;
        background: linear-gradient(180deg, #ffffff, #b9c0ef);
        -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
      }
      .sc-lede { font-family: var(--font-serif); font-size: 1.24rem; line-height: 1.6; color: var(--ink-dim); max-width: 60ch; }

      .sc-main { max-width: 820px; margin: 0 auto; padding: 1rem 1.5rem 5rem; }
      .sc-article { max-width: 720px; }
      .sc-article :global(h2) {
        position: relative; padding-left: 1.1rem; margin-top: 3.5rem;
        font-size: clamp(1.5rem, 3vw, 1.9rem); letter-spacing: -0.02em;
      }
      .sc-article :global(h2)::before {
        content: ""; position: absolute; left: 0; top: 0.18em; bottom: 0.18em;
        width: 4px; border-radius: 2px; background: var(--accent);
        box-shadow: 0 0 10px rgba(139, 147, 248, 0.7);
      }
      .sc-article :global(a) { border-bottom-color: rgba(52, 231, 201, 0.3); }

      .sc-foot { max-width: 820px; margin: 0 auto 4rem; padding: 1.5rem; border-top: 1px solid var(--rule); }

      @media (max-width: 640px) { .sc-hero, .sc-main, .sc-topbar, .sc-foot { padding-left: 1.25rem; padding-right: 1.25rem; } }
    </style>

    <script>
      import { animate, stagger } from 'animejs';
      import { prefersReducedMotion } from '../scripts/scrolly.js';
      import { attachReveals } from '../scripts/reveal.js';

      function heroEntrance() {
        if (prefersReducedMotion()) return;
        const els = document.querySelectorAll('.sc-hero > *');
        if (els.length) animate(els, { opacity: [0, 1], translateY: [18, 0], duration: 700, ease: 'out(3)', delay: stagger(90) });
      }

      function progressBar() {
        const bar = document.querySelector('[data-sc-progress]');
        if (!bar) return;
        if (prefersReducedMotion()) { bar.style.display = 'none'; return; }
        let raf = 0;
        const compute = () => {
          raf = 0;
          const h = document.documentElement;
          const max = h.scrollHeight - h.clientHeight;
          bar.style.transform = 'scaleX(' + (max > 0 ? (h.scrollTop / max).toFixed(4) : 0) + ')';
        };
        const onScroll = () => { if (!raf) raf = requestAnimationFrame(compute); };
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll);
        compute();
      }

      function init() { heroEntrance(); progressBar(); attachReveals(document); }
      init();
      document.addEventListener('astro:after-swap', init);
    </script>
  </body>
</html>
