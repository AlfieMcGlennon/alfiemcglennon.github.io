---
import Base from './Base.astro';

const { title, description, date, tags, image, project, math } = Astro.props;

const formatted = new Date(date).toLocaleDateString('en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const ogTitle = `${title} | Alfie McGlennon`;
const ogDescription = description;
---

<Base
  title={ogTitle}
  description={description}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  image={image}
  ogType="article"
  publishedTime={new Date(date).toISOString()}
  tags={tags}
  headline={title}
  math={math}
>
  <article class="page-narrow post" data-project={project}>
    <header class="post-head">
      <p class="kicker">Writing</p>
      <h1>{title}</h1>
      <p class="post-meta">
        <time datetime={new Date(date).toISOString()}>{formatted}</time>
        {tags && tags.length > 0 && (
          <>
            <span class="sep">·</span>
            <span class="post-tags">{tags.join(' · ')}</span>
          </>
        )}
      </p>
      {description && <p class="lede">{description}</p>}
    </header>

    <div class="post-body">
      <slot />
    </div>

    <footer class="post-foot">
      <a href="/writing/" class="back-link">&larr; All writing</a>
    </footer>
  </article>
</Base>

<style>
  .post-head {
    margin-bottom: 2.25rem;
  }

  .post-meta {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--ink-muted);
    margin: 0.6rem 0 1.4rem;
    line-height: 1.6;
  }

  .post-meta .sep {
    color: var(--ink-faint);
    margin: 0 0.4rem;
  }

  .post-tags {
    color: var(--ink-muted);
  }

  .post-hero {
    margin: 0 0 2rem;
    border: 1px solid var(--rule);
    border-radius: 4px;
    overflow: hidden;
    background: var(--bg-raised);
  }

  .post-hero img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0;
  }

  .post-body :global(h2) {
    margin-top: 3rem;
  }

  .post-body :global(h3) {
    margin-top: 2.25rem;
  }

  .post-body :global(blockquote) {
    margin: 2.5rem 0 2.5rem -0.5rem;
    padding: 0.4rem 0 0.4rem 1.5rem;
    border-left: 3px solid var(--amber);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.22rem;
    line-height: 1.55;
    color: var(--ink-dim);
    background: linear-gradient(to right, rgba(180, 83, 9, 0.04), transparent 60%);
  }

  .post-body :global(blockquote p) {
    margin-bottom: 0.6rem;
    font-size: inherit;
    line-height: inherit;
    color: inherit;
    font-style: inherit;
  }

  .post-body :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .post-body :global(img) {
    margin: 1.75rem 0 0.75rem;
    border: 1px solid var(--rule);
    border-radius: 4px;
    width: 100%;
    height: auto;
  }

  .post-body :global(table) {
    font-size: 0.92rem;
  }

  .post-foot {
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }

  .back-link {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--ink-muted);
    border-bottom: 0;
  }

  .back-link:hover {
    color: var(--teal);
  }

  /* Section kicker sitting tight above its heading (quantum-weather post). */
  .post-body :global(.kicker) {
    margin-top: 3.25rem;
    margin-bottom: 0;
  }

  .post-body :global(.kicker + h2) {
    margin-top: 0.35rem;
  }

  /* "Go deeper" collapsible folds for standard (non-grand) posts. */
  .post-body :global(details.fold) {
    margin: 1.6rem 0 1.9rem;
    border: 1px solid var(--rule);
    border-left: 3px solid var(--accent);
    border-radius: 6px;
    background: var(--bg-raised);
    padding: 0 1.15rem;
    overflow: hidden;
  }

  .post-body :global(details.fold > summary) {
    cursor: pointer;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    letter-spacing: 0.01em;
    color: var(--accent);
    font-weight: 500;
    padding: 0.85rem 0;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .post-body :global(details.fold > summary::-webkit-details-marker) {
    display: none;
  }

  .post-body :global(details.fold > summary::before) {
    content: "+";
    font-family: var(--font-mono);
    font-size: 1.05rem;
    line-height: 1;
    width: 1rem;
    text-align: center;
    color: var(--accent);
  }

  .post-body :global(details.fold[open] > summary::before) {
    content: "−";
  }

  .post-body :global(details.fold[open] > summary) {
    border-bottom: 1px solid var(--rule);
    margin-bottom: 0.5rem;
  }

  .post-body :global(details.fold > :not(summary)) {
    font-size: 0.98rem;
  }

  .post-body :global(details.fold > :last-child) {
    margin-bottom: 1.1rem;
  }

  .post-body :global(details.fold summary:focus-visible) {
    outline: 2px solid var(--teal);
    outline-offset: 3px;
    border-radius: 3px;
  }
</style>
